<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qianxun.homestay.modules.points.mapper.PointsLogMapper">
    <resultMap id="pointsLogResultMap" type="com.qianxun.homestay.modules.points.entity.PointsLogEntity">
        <id property="id" column="id"/>
        <result property="memberId" column="member_id"/>
        <result property="orderId" column="order_id"/>
        <result property="type" column="type"/>
        <result property="points" column="points"/>
        <result property="growthPoints" column="growth_points"/>
        <result property="balanceAfter" column="balance_after"/>
        <result property="amount" column="amount"/>
        <result property="discountAmount" column="discount_amount"/>
        <result property="refNo" column="ref_no"/>
        <result property="remark" column="remark"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="findByRefNo" resultMap="pointsLogResultMap">
        SELECT id, member_id, order_id, type, points, growth_points, balance_after,
               amount, discount_amount, ref_no, remark, created_at
        FROM points_log WHERE ref_no = #{refNo}
    </select>

    <sql id="pointsLogFilters">
        <where>
            <if test="memberId != null">AND member_id = #{memberId}</if>
            <if test="orderId != null">AND order_id = #{orderId}</if>
            <if test="type != null">AND type = #{type}</if>
        </where>
    </sql>

    <select id="findPage" resultMap="pointsLogResultMap">
        SELECT id, member_id, order_id, type, points, growth_points, balance_after,
               amount, discount_amount, ref_no, remark, created_at
        FROM points_log
        <include refid="pointsLogFilters"/>
        ORDER BY created_at DESC, id DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countPage" resultType="long">
        SELECT COUNT(*) FROM points_log
        <include refid="pointsLogFilters"/>
    </select>

    <select id="existsByRefNo" resultType="boolean">
        SELECT EXISTS (SELECT 1 FROM points_log WHERE ref_no = #{refNo})
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO points_log (
            member_id, order_id, type, points, growth_points, balance_after, amount,
            discount_amount, ref_no, remark
        ) VALUES (
            #{memberId}, #{orderId}, #{type}, #{points}, #{growthPoints}, #{balanceAfter}, #{amount},
            #{discountAmount}, #{refNo}, #{remark}
        )
    </insert>
</mapper>
