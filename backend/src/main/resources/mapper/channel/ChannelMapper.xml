<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qianxun.homestay.modules.channel.mapper.ChannelMapper">
    <resultMap id="channelResultMap" type="com.qianxun.homestay.modules.channel.entity.ChannelEntity">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="enabled" column="enabled"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findAll" resultMap="channelResultMap">
        SELECT id, name, enabled, created_at, updated_at
        FROM channels
        ORDER BY id
    </select>

    <select id="findById" resultMap="channelResultMap">
        SELECT id, name, enabled, created_at, updated_at
        FROM channels
        WHERE id = #{id}
    </select>

    <update id="updateEnabled">
        UPDATE channels SET enabled = #{enabled} WHERE id = #{id}
    </update>
</mapper>
