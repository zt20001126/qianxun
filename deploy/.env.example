MYSQL_DATABASE=qianxun_homestay
MYSQL_USER=qianxun
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306
BACKEND_PORT=8080

# Generate one persistent random key (Base64 encoded, at least 32 random bytes).
JWT_SECRET=

# Set these only for first startup when admin is empty. Remove the password afterward.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_JWT_EXPIRATION_SECONDS=28800
MEMBER_DEFAULT_AVATAR=/assets/avatar-default.webp
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# 国内镜像配置：Docker 可切换到 docker.io；Maven 可切换到 huawei 或 central。
DOCKER_REGISTRY_PREFIX=docker.m.daocloud.io
MAVEN_MIRROR_PROFILE=aliyun
