.mall-page { min-height: 100vh; padding-bottom: calc(80rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #faf7f2; }
.mall-content { margin: 0 32rpx; padding-top: 48rpx; }
.mall-title-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 28rpx; }
.title-rail { width: 8rpx; height: 34rpx; border-radius: 6rpx; background: #8b4d25; }
.mall-title { color: #6f3b1a; font-family: "Songti SC", "Noto Serif SC", serif; font-size: 32rpx; font-weight: 700; }
.product-list { display: flex; flex-direction: column; }
.product-card + .product-card { margin-top: 24rpx; }
.product-card { display: flex; align-items: stretch; gap: 28rpx; min-height: 206rpx; padding: 24rpx; border: 1rpx solid rgba(232, 224, 212, .7); border-radius: 32rpx; background: #fff; box-shadow: 0 8rpx 40rpx rgba(35, 31, 29, .05); }
.product-cover { flex: none; width: 216rpx; height: 188rpx; border-radius: 24rpx; background: #f3ede2; }
.product-cover-empty { display: flex; align-items: center; justify-content: center; color: #8b4d25; font-family: "Songti SC", serif; font-size: 22rpx; }
.product-info { display: flex; flex: 1; flex-direction: column; justify-content: space-between; min-width: 0; padding: 4rpx 0; }
.product-name { overflow: hidden; color: #231f1d; font-family: "Songti SC", "Noto Serif SC", serif; font-size: 30rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.product-description { display: -webkit-box; overflow: hidden; margin-top: 12rpx; color: #7a726b; font-size: 22rpx; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.product-card-bottom { display: flex; width: 100%; min-width: 0; align-items: center; justify-content: space-between; gap: 8rpx; box-sizing: border-box; margin-top: 20rpx; }
.price { display: flex; align-items: baseline; white-space: nowrap; }
.price text:first-child { color: #b83b2a; font-size: 34rpx; font-weight: 700; }
.price text:last-child { margin-left: 5rpx; color: #7a726b; font-size: 22rpx; }
.product-card-bottom .detail-button { display: flex; flex: 0 0 156rpx; width: 156rpx; min-width: 156rpx; max-width: 156rpx; height: 58rpx; align-items: center; justify-content: center; box-sizing: border-box; margin: 0; padding: 0; border-radius: 24rpx; color: #fff; background: #8b4d25; box-shadow: 0 4rpx 12rpx rgba(35, 31, 29, .08); font-size: 24rpx; font-weight: 500; line-height: 1; white-space: nowrap; }
.detail-button::after, .retry-button::after { border: 0; }
.mall-state { display: flex; min-height: 260rpx; flex-direction: column; align-items: center; justify-content: center; gap: 24rpx; padding: 40rpx; border: 1rpx solid #e8e0d4; border-radius: 32rpx; color: #7a726b; background: #fff; font-size: 22rpx; text-align: center; }
.mall-error { color: #b83b2a; }
.retry-button { min-height: 68rpx; margin: 0; padding: 0 36rpx; border: 1rpx solid #e8e0d4; border-radius: 999rpx; color: #8b4d25; background: #fff; font-size: 21rpx; line-height: 66rpx; }
