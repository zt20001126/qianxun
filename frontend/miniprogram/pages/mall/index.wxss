.mall-page{min-height:100vh;box-sizing:border-box;padding:40rpx 32rpx 80rpx;background:#fbf5ef;color:#292522}.mall-heading{display:flex;flex-direction:column;gap:10rpx;margin-bottom:32rpx}.mall-title{font-size:38rpx;font-weight:700;color:#512a18}.mall-subtitle{font-size:24rpx;color:#8a786d}.mall-state{padding:100rpx 20rpx;text-align:center;color:#7a726b;font-size:26rpx}.retry{margin-top:24rpx;color:#98501f;background:#fffcf9;font-size:24rpx}.product-list{display:flex;flex-direction:column;gap:24rpx}.product-card{display:flex;overflow:hidden;padding:20rpx;border-radius:24rpx;background:#fffcf9;box-shadow:0 8rpx 32rpx rgba(81,42,24,.06)}.product-image{width:200rpx;height:200rpx;flex:none;border-radius:16rpx;background:#f5e5d6}.product-copy{display:flex;min-width:0;flex:1;flex-direction:column;padding:8rpx 24rpx}.product-name{font-size:30rpx;font-weight:600;color:#512a18}.product-desc{overflow:hidden;margin-top:12rpx;color:#7a726b;font-size:24rpx;text-overflow:ellipsis;white-space:nowrap}.product-price{margin-top:auto;color:#d74332;font-size:32rpx;font-weight:600}
