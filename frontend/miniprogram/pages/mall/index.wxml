<view class="mall-page">
  <view class="mall-content">
    <view class="mall-title-row"><view class="title-rail"></view><text class="mall-title">芊浔好物</text></view>
    <view wx:if="{{loading}}" class="mall-state">正在加载好物…</view>
    <view wx:elif="{{error}}" class="mall-state mall-error"><text>{{error}}</text><button class="retry-button" bindtap="onRetry">重新加载</button></view>
    <view wx:elif="{{!products.length}}" class="mall-state">暂无上架商品，敬请期待</view>
    <view wx:else class="product-list">
      <view wx:for="{{products}}" wx:key="id" class="product-card" data-id="{{item.id}}" bindtap="onDetailTap">
        <image wx:if="{{item.images.length}}" class="product-cover" src="{{item.images[0]}}" mode="aspectFill" />
        <view wx:else class="product-cover product-cover-empty">暂无商品图片</view>
        <view class="product-info">
          <text class="product-name">{{item.name}}</text>
          <text wx:if="{{item.description}}" class="product-description">{{item.description}}</text>
          <view class="product-card-bottom">
            <view class="price"><text>¥{{item.price}}</text><text>/件</text></view>
            <button class="detail-button" data-id="{{item.id}}" catchtap="onDetailTap">查看详情</button>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
