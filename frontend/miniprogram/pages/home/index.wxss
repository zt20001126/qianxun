.home-page { min-height: 100vh; padding-bottom: 48rpx; box-sizing: border-box; color: #231f1d; background: #faf7f2; }
.home-hero { position: relative; height: 460rpx; overflow: hidden; }
.home-hero-image { display: block; width: 100%; height: 100%; }
.home-hero-shade { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: linear-gradient(0deg, #faf7f2 0%, rgba(24, 21, 18, .25) 55%, rgba(24, 21, 18, .15) 100%); }
.home-brand { position: absolute; top: 48rpx; left: 0; right: 0; display: flex; flex-direction: column; align-items: center; color: #fff; text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, .3); }
.brand-title-row { display: flex; align-items: center; gap: 16rpx; }
.brand-title { font-family: "Songti SC", "Noto Serif SC", serif; font-size: 56rpx; font-weight: 700; letter-spacing: 7rpx; }
.brand-seal { display: flex; width: 42rpx; height: 48rpx; flex-direction: column; align-items: center; justify-content: center; border-radius: 6rpx; color: #fff; background: #b83b2a; font-family: "Songti SC", serif; font-size: 19rpx; font-weight: 700; line-height: 1.15; }
.brand-subtitle { margin-top: 10rpx; color: rgba(255, 255, 255, .95); font-size: 23rpx; letter-spacing: 5rpx; }
.booking-card { position: relative; z-index: 2; margin: -112rpx 32rpx 0; padding: 32rpx; border: 1rpx solid rgba(232, 224, 212, .8); border-radius: 52rpx; background: rgba(255, 255, 255, .98); box-shadow: 0 16rpx 48rpx rgba(139, 77, 37, .08); }
.date-selector { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 30rpx; border: 1rpx solid rgba(232, 224, 212, .7); border-radius: 32rpx; background: rgba(250, 247, 242, .86); }
.date-side { display: flex; flex: 1; flex-direction: column; min-width: 0; }
.date-side-out { align-items: flex-end; text-align: right; }
.date-caption { color: #7a726b; font-size: 22rpx; }
.date-value-row { display: flex; align-items: baseline; gap: 12rpx; margin-top: 8rpx; }
.date-value-row-out { justify-content: flex-end; }
.date-main { color: #231f1d; font-family: "Songti SC", "Noto Serif SC", serif; font-size: 36rpx; font-weight: 700; }
.date-week { color: #7a726b; font-size: 24rpx; }
.nights-row { display: flex; justify-content: center; margin: 24rpx 0; }
.nights-pill { display: flex; align-items: center; gap: 12rpx; padding: 12rpx 40rpx; border: 1rpx solid rgba(139, 77, 37, .15); border-radius: 999rpx; color: #8b4d25; background: #f7efe8; font-size: 24rpx; font-weight: 600; }
.booking-card .search-button { display: flex; width: 100%; height: 100rpx; align-items: center; justify-content: center; box-sizing: border-box; margin: 0; padding: 0 20rpx; border-radius: 32rpx; color: #fff; background: #8b4d25; box-shadow: 0 14rpx 36rpx rgba(139, 77, 37, .22); font-size: 30rpx; font-weight: 500; line-height: 1; }
.booking-card .search-button::after { border: 0; }
.room-count-error { display: block; margin-top: 12rpx; color: #b83b2a; font-size: 19rpx; text-align: center; }
.quick-entries { display: grid; grid-template-columns: repeat(4, 1fr); margin: 40rpx 32rpx 0; padding: 16rpx 0; }
.quick-entries .quick-entry { display: flex; width: 100%; flex-direction: column; align-items: center; gap: 16rpx; box-sizing: border-box; margin: 0; padding: 0; color: #231f1d; background: transparent; font-size: 24rpx; font-weight: 500; line-height: 1.4; }
.quick-entries .quick-entry + .quick-entry { box-sizing: border-box; border-left: 1rpx solid rgba(232, 224, 212, .8); }
.quick-entries .quick-entry::after { border: 0; }
.quick-icon { display: grid; width: 88rpx; height: 88rpx; place-items: center; border: 1rpx solid rgba(139, 77, 37, .1); border-radius: 50%; background: #f7efe8; }
.nanxun-banner { position: relative; height: 232rpx; margin: 32rpx 32rpx 0; overflow: hidden; border: 1rpx solid rgba(232, 224, 212, .7); border-radius: 32rpx; box-shadow: 0 8rpx 40rpx rgba(35, 31, 29, .05); }
.banner-image { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; }
.banner-shade { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: linear-gradient(90deg, #faf3e8 0%, rgba(250, 243, 232, .92) 44%, rgba(250, 243, 232, 0) 100%); }
.banner-copy { position: absolute; top: 0; bottom: 0; left: 32rpx; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; }
.banner-title { color: #6f3b1a; font-family: "Songti SC", "Noto Serif SC", serif; font-size: 36rpx; font-weight: 700; letter-spacing: 1rpx; }
.banner-subtitle { margin-top: 4rpx; color: rgba(139, 77, 37, .85); font-size: 24rpx; }
.banner-action { display: flex; align-items: center; gap: 8rpx; margin-top: 16rpx; padding: 8rpx 24rpx; border-radius: 999rpx; color: #fff; background: #8b4d25; box-shadow: 0 4rpx 12rpx rgba(35, 31, 29, .08); font-size: 22rpx; }
.guide-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 1200; display: flex; align-items: center; justify-content: center; padding: 48rpx; box-sizing: border-box; background: rgba(35, 31, 29, .5); }
.guide-dialog { width: 100%; padding: 48rpx; border: 1rpx solid #e8e0d4; border-radius: 48rpx; background: #fff; box-shadow: 0 24rpx 64rpx rgba(35, 31, 29, .2); }
.guide-tag { display: inline-block; padding: 6rpx 20rpx; border-radius: 999rpx; color: #8b4d25; background: #f7efe8; font-size: 21rpx; font-weight: 600; }
.guide-title { display: block; margin-top: 18rpx; color: #231f1d; font-family: "Songti SC", "Noto Serif SC", serif; font-size: 34rpx; font-weight: 700; }
.guide-body { display: block; margin-top: 24rpx; color: rgba(35, 31, 29, .85); font-size: 23rpx; line-height: 1.75; white-space: pre-line; }
.guide-extra { margin-top: 30rpx; padding: 24rpx; border: 1rpx solid #e8e0d4; border-radius: 24rpx; color: #8b4d25; background: #faf7f2; font-size: 21rpx; font-weight: 500; line-height: 1.5; }
.guide-close { display: flex; width: 280rpx; height: 76rpx; align-items: center; justify-content: center; margin: 36rpx auto 0; padding: 0; border: 1rpx solid #e7d4c2; border-radius: 999rpx; color: #80502f; background: #fbf5ef; box-shadow: 0 6rpx 16rpx rgba(100, 65, 39, .08); font-size: 26rpx; font-weight: 600; letter-spacing: 2rpx; line-height: 1; }
.guide-close::after { border: 0; }
.guide-close-hover { background: #f4e9de; box-shadow: 0 3rpx 10rpx rgba(100, 65, 39, .06); }
