.home-page { min-height: 100vh; padding: 30rpx 34rpx 26rpx; box-sizing: border-box; background: #fbf5ef; }
.home-topline { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 2rpx 28rpx; }
.brand-lockup { display: flex; align-items: center; }
.brand-seal { display: grid; width: 70rpx; height: 70rpx; place-items: center; border: 2rpx solid #98501f; border-radius: 50%; color: #98501f; font-family: serif; font-size: 36rpx; }
.brand-copy { display: flex; flex-direction: column; margin-left: 17rpx; }
.brand-name { color: #512a18; font-family: serif; font-size: 31rpx; font-weight: 600; letter-spacing: 4rpx; }
.brand-place { margin-top: 6rpx; color: #a18e7b; font-size: 18rpx; letter-spacing: 2rpx; }
.logout-link { min-width: 74rpx; margin: 0; padding: 8rpx 14rpx; border: 1rpx solid #e5d9cb; border-radius: 999rpx; color: #8c7661; background: #fffcf9; font-size: 20rpx; line-height: 1.5; }
.logout-link::after { border: 0; }
.member-strip { display: flex; align-items: center; min-height: 94rpx; padding: 17rpx 20rpx; border: 1rpx solid #eee4da; border-radius: 16rpx; background: #fffcf9; box-shadow: 0 8rpx 24rpx rgba(87, 60, 39, .04); }
.member-strip-loading, .member-strip-error { justify-content: center; color: #918276; font-size: 22rpx; }
.member-strip-error { color: #b34335; }
.member-avatar { width: 63rpx; height: 63rpx; border-radius: 50%; background: #f2e6d8; }
.member-copy { display: flex; flex: 1; flex-direction: column; margin-left: 16rpx; }
.member-name { color: #512a18; font-size: 23rpx; font-weight: 600; }
.member-phone { margin-top: 6rpx; color: #a0958b; font-size: 19rpx; }
.member-points { display: flex; flex-direction: column; align-items: flex-end; color: #a18b73; font-size: 17rpx; }
.member-points text:first-child { color: #98501f; font-family: Georgia, serif; font-size: 27rpx; }
.intro-block { display: flex; flex-direction: column; padding: 52rpx 8rpx 48rpx; }
.intro-kicker { color: #a6886a; font-size: 17rpx; letter-spacing: 4rpx; }
.intro-title { margin-top: 17rpx; color: #512a18; font-family: serif; font-size: 43rpx; font-weight: 600; letter-spacing: 5rpx; }
.intro-copy { margin-top: 12rpx; color: #918477; font-size: 22rpx; letter-spacing: 1rpx; }
.date-search-card { margin: 0 0 30rpx; padding: 23rpx; border: 1rpx solid #eadfd3; border-radius: 17rpx; background: #fffcf9; box-shadow: 0 9rpx 24rpx rgba(78, 54, 34, .055); }
.date-search-heading { display: flex; align-items: baseline; justify-content: space-between; color: #512a18; font-size: 24rpx; font-weight: 600; }
.date-search-heading text:last-child { color: #9b7150; font-size: 19rpx; font-weight: 400; }
.date-pickers { display: flex; align-items: center; gap: 17rpx; margin-top: 18rpx; }
.date-pickers picker { flex: 1; min-width: 0; }
.date-choice { display: flex; min-height: 81rpx; flex-direction: column; justify-content: center; gap: 8rpx; padding: 0 15rpx; border: 1rpx solid #eee2d6; border-radius: 10rpx; background: #fffaf5; }
.date-choice > text:first-child { color: #a18d79; font-size: 17rpx; }
.date-value { color: #4f4033; font-size: 22rpx; }
.date-search-note { display: block; margin-top: 13rpx; color: #a39588; font-size: 17rpx; line-height: 1.5; }
.date-search-actions { display: flex; align-items: center; gap: 12rpx; margin-top: 17rpx; }
.search-rooms-button { flex: 1; height: 76rpx; border: 0; border-radius: 10rpx; color: #fffaf4; background: #98501f; font-size: 22rpx; line-height: 76rpx; }
.search-rooms-button::after { border: 0; }
.clear-dates-button { min-width: 126rpx; height: 76rpx; border: 1rpx solid #decdbc; border-radius: 10rpx; color: #795b43; background: #fffdfa; font-size: 20rpx; line-height: 74rpx; }
.clear-dates-button::after { border: 0; }
.section-heading { display: flex; align-items: flex-end; justify-content: space-between; margin: 0 3rpx 19rpx; }
.section-heading view { display: flex; align-items: baseline; gap: 13rpx; }
.section-title { color: #512a18; font-family: serif; font-size: 32rpx; font-weight: 600; }
.section-caption, .section-note { color: #a09285; font-size: 18rpx; }
.room-list { display: flex; flex-direction: column; gap: 20rpx; }
.room-card { overflow: hidden; border: 1rpx solid #eee3d8; border-radius: 18rpx; background: #fffcf9; box-shadow: 0 10rpx 28rpx rgba(78, 54, 34, .055); }
.room-cover { display: block; width: 100%; height: 345rpx; background: #f2e7dc; }
.room-cover-empty { display: grid; place-items: center; color: #ad9984; background: linear-gradient(135deg, #f5e6d8, #ede0d2); font-family: serif; font-size: 23rpx; letter-spacing: 4rpx; }
.room-card-content { padding: 22rpx 23rpx 20rpx; }
.room-card-heading, .room-card-footer { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.room-card-heading > view:first-child { display: flex; flex: 1; flex-direction: column; min-width: 0; }
.room-name { overflow: hidden; color: #512a18; font-family: serif; font-size: 28rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.room-meta { margin-top: 9rpx; color: #9d8f82; font-size: 19rpx; }
.room-price { display: flex; align-items: baseline; color: #d74332; white-space: nowrap; }
.room-price text:first-child { font-family: Georgia, serif; font-size: 32rpx; font-weight: 600; }
.room-price text:last-child { margin-left: 4rpx; color: #a99a8d; font-size: 17rpx; }
.room-card-footer { margin-top: 19rpx; padding-top: 15rpx; border-top: 1rpx solid #f0e9e1; }
.room-bed { overflow: hidden; flex: 1; color: #83766a; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.room-detail-link { color: #98501f; font-size: 20rpx; white-space: nowrap; }
.page-state { display: flex; min-height: 210rpx; flex-direction: column; align-items: center; justify-content: center; gap: 14rpx; border: 1rpx solid #eee3d8; border-radius: 16rpx; color: #96897d; background: #fffcf9; font-size: 22rpx; text-align: center; }
.page-state-error { color: #a94438; }
.retry-button { min-height: 64rpx; padding: 0 24rpx; border: 1rpx solid #d9c8b7; border-radius: 9rpx; color: #795b43; background: #fffdfa; font-size: 21rpx; line-height: 62rpx; }
.retry-button::after { border: 0; }
.empty-mark { display: grid; width: 66rpx; height: 66rpx; place-items: center; border: 1rpx solid #e5d1bd; border-radius: 50%; color: #b18b68; font-family: serif; font-size: 30rpx; }
.bottom-decoration { display: block; width: 100%; margin-top: 54rpx; opacity: .66; }
.home-footer { display: block; padding: 8rpx 0 16rpx; color: #b09e8c; font-size: 17rpx; letter-spacing: 3rpx; text-align: center; }
