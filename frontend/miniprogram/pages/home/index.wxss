.page-shell { min-height: 100vh; padding: 42rpx; box-sizing: border-box; background: linear-gradient(180deg, #f6eadc, #fbf5ef 420rpx); }
.welcome-card { display: flex; flex-direction: column; align-items: center; padding: 52rpx 20rpx 44rpx; }
.seal { display: grid; width: 76rpx; height: 76rpx; place-items: center; border: 2rpx solid #98501f; border-radius: 50%; color: #98501f; font-family: serif; font-size: 38rpx; }
.eyebrow { margin-top: 24rpx; color: #a1866b; font-size: 17rpx; letter-spacing: 4rpx; }
.title { margin-top: 12rpx; color: #512a18; font-family: serif; font-size: 50rpx; letter-spacing: 6rpx; }
.subtitle { margin-top: 12rpx; color: #918275; font-size: 23rpx; letter-spacing: 2rpx; }
.member-card { display: flex; align-items: center; padding: 30rpx 26rpx; border: 1rpx solid #eee3d7; border-radius: 18rpx; background: #fffcf9; box-shadow: 0 12rpx 36rpx rgba(87, 60, 39, .06); }
.avatar { width: 92rpx; height: 92rpx; border-radius: 50%; background: #f2e6d8; }
.member-info { display: flex; flex: 1; flex-direction: column; margin-left: 20rpx; }
.nickname { color: #512a18; font-size: 30rpx; font-weight: 600; }
.phone { margin-top: 8rpx; color: #92857a; font-size: 23rpx; }
.points-box { display: flex; flex-direction: column; align-items: flex-end; }
.points-value { color: #98501f; font-family: Georgia, serif; font-size: 34rpx; }
.points-label { margin-top: 5rpx; color: #9a8a7d; font-size: 19rpx; }
.state-message { padding: 36rpx 8rpx; color: #877a6d; text-align: center; font-size: 24rpx; }
.error { color: #b34335; }
.phase-note { margin-top: 40rpx; color: #a19589; font-size: 21rpx; line-height: 1.6; text-align: center; }
.logout-button { width: 100%; height: 82rpx; margin-top: 36rpx; border: 1rpx solid #d8c8b8; border-radius: 12rpx; color: #795b43; background: transparent; font-size: 25rpx; line-height: 80rpx; }
.townscape { width: 100%; margin-top: 90rpx; opacity: .7; }
