<view class="home-page">
  <view class="home-hero">
    <image class="home-hero-image" src="../../assets/login-baijianlou-hero.jpg" mode="aspectFill" />
    <view class="home-hero-shade"></view>
    <view class="home-brand">
      <view class="brand-title-row">
        <text class="brand-title">芊浔民宿</text>
        <view class="brand-seal">
          <text>南</text>
          <text>浔</text>
        </view>
      </view>
      <text class="brand-subtitle">—— 枕水而居 · 诗意南浔 ——</text>
    </view>
  </view>

  <view class="booking-card">
    <view class="date-selector" bindtap="onCalendarOpen">
      <view class="date-side">
        <text class="date-caption">入住日期</text>
        <view class="date-value-row">
          <text class="date-main">{{checkInLabel}}</text>
          <text class="date-week">{{checkInWeek}}</text>
        </view>
      </view>
      <qx-icon name="arrow-right" size="32" />
      <view class="date-side date-side-out">
        <text class="date-caption">退房日期</text>
        <view class="date-value-row date-value-row-out">
          <text class="date-main">{{checkOutLabel}}</text>
          <text class="date-week">{{checkOutWeek}}</text>
        </view>
      </view>
    </view>

    <view class="nights-row" bindtap="onCalendarOpen">
      <view class="nights-pill"><qx-icon name="moon" size="27" /><text>共 {{nights}} 晚</text></view>
    </view>

    <button class="search-button" loading="{{roomsLoading}}" bindtap="onSearchTap">
      {{roomsLoading ? '正在查询房态…' : searchButtonLabel}}
    </button>
    <text wx:if="{{roomsError}}" class="room-count-error">房态读取失败，进入列表可重试</text>
  </view>

  <view class="quick-entries">
    <button class="quick-entry" data-type="intro" bindtap="onGuideTap">
      <view class="quick-icon"><qx-icon name="landmark" size="40" /></view>
      <text>民宿介绍</text>
    </button>
    <button class="quick-entry" bindtap="onSearchTap">
      <view class="quick-icon"><qx-icon name="bed-double" size="40" /></view>
      <text>房型一览</text>
    </button>
    <button class="quick-entry" data-type="around" bindtap="onGuideTap">
      <view class="quick-icon"><qx-icon name="sprout" size="40" /></view>
      <text>周边游玩</text>
    </button>
    <button class="quick-entry" data-type="traffic" bindtap="onGuideTap">
      <view class="quick-icon"><qx-icon name="map-pin" size="40" /></view>
      <text>交通指引</text>
    </button>
  </view>

  <view class="nanxun-banner" data-type="nanxun" bindtap="onGuideTap">
    <image class="banner-image" src="../../assets/login-baijianlou-hero.jpg" mode="aspectFill" />
    <view class="banner-shade"></view>
    <view class="banner-copy">
      <text class="banner-title">走进南浔古镇</text>
      <text class="banner-subtitle">百间楼夜色 · 江南水乡韵</text>
      <view class="banner-action">了解南浔 <qx-icon name="chevron-right-white" size="24" /></view>
    </view>
  </view>

  <booking-calendar
    visible="{{calendarVisible}}"
    check-in="{{checkIn}}"
    check-out="{{checkOut}}"
    bind:close="onCalendarClose"
    bind:confirm="onCalendarConfirm" />

  <view wx:if="{{guideVisible}}" class="guide-mask" catchtap="onGuideClose">
    <view class="guide-dialog" catchtap="noop">
      <text class="guide-tag">{{guide.tag}}</text>
      <text class="guide-title">{{guide.title}}</text>
      <text class="guide-body">{{guide.body}}</text>
      <view class="guide-extra">{{guide.extra}}</view>
      <button class="guide-close" bindtap="onGuideClose">我知道了</button>
    </view>
  </view>
</view>
