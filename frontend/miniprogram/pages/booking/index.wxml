<view class="booking-page">
  <view wx:if="{{loading}}" class="booking-state">正在准备预订信息…</view>
  <view wx:elif="{{errorMessage && !room}}" class="booking-state booking-error">{{errorMessage}}</view>
  <view wx:else>
    <view class="booking-card room-summary-card">
      <view class="room-summary-top">
        <image wx:if="{{room.images.length}}" class="summary-image" src="{{room.images[0]}}" mode="aspectFill" />
        <view wx:else class="summary-image summary-image-empty">芊浔雅居</view>
        <view class="summary-room-info">
          <text class="summary-room-name">{{room.name}}</text>
        <text class="summary-room-meta">{{room.bed_info || '雅致客房'}} · 可住{{room.capacity}}人 · {{room.area || '—'}}㎡</text>
        </view>
      </view>
      <view class="summary-stay-row" bindtap="onCalendarOpen">
        <view class="summary-stay-dates">
          <qx-icon name="calendar" size="28" />
          <view><text class="summary-date-label">入住：</text><text class="summary-date-value">{{checkInLabel}}</text><text class="summary-date-week"> {{checkInWeek}}</text></view>
          <text class="summary-stay-arrow">→</text>
          <view><text class="summary-date-label">退房：</text><text class="summary-date-value">{{checkOutLabel}}</text><text class="summary-date-week"> {{checkOutWeek}}</text></view>
        </view>
        <text class="summary-nights">共{{nights}}晚</text>
      </view>
    </view>

    <view class="booking-card form-card">
      <view class="section-heading"><view class="section-rail"></view><text>预订信息</text></view>
      <view class="form-fields">
        <view class="form-row">
          <label><qx-icon name="user" size="28" />预订人 <text class="required">*</text></label>
          <input maxlength="80" placeholder="请输入预订人姓名" value="{{guestName}}" bindinput="onGuestNameInput" />
        </view>
        <view class="form-row">
          <label><qx-icon name="phone" size="28" />手机号码 <text class="required">*</text></label>
          <input type="number" maxlength="11" placeholder="请输入手机号码" value="{{phone}}" bindinput="onPhoneInput" />
        </view>
        <view class="form-row">
          <label><qx-icon name="users" size="28" />入住人数 <text class="required">*</text></label>
          <view class="guest-counter">
            <button data-delta="-1" disabled="{{guestCount <= 1}}" bindtap="onGuestCountStep">—</button>
            <text>{{guestCount}}</text>
            <button data-delta="1" disabled="{{guestCount >= room.capacity}}" bindtap="onGuestCountStep">+</button>
          </view>
        </view>
        <view class="form-row">
          <label><qx-icon name="file-text" size="28" />备注</label>
          <input maxlength="500" placeholder="请输入备注（如有特殊需求）" value="{{remark}}" bindinput="onRemarkInput" />
        </view>
      </view>
    </view>

    <view class="booking-card fee-card">
      <view class="fee-title-row">
        <view class="section-heading"><view class="section-rail"></view><text>费用明细</text></view>
        <text wx:if="{{preview}}" class="tier-pill">{{tierLabel}}</text>
      </view>
      <view wx:if="{{preview}}" class="fee-line">
        <text>房费</text>
        <text class="fee-equation">¥{{roomPriceLabel}} × {{nights}}晚</text>
        <text class="fee-value">¥{{roomAmountLabel}}</text>
      </view>
      <view wx:else class="fee-loading">{{previewLoading ? '正在试算费用…' : '费用暂不可用'}}</view>

      <view class="points-row">
        <view class="points-description">
          <view class="points-title-row">
            <text class="points-title">积分抵扣</text>
            <view class="points-help" bindtap="onPointsRuleOpen"><qx-icon name="info" size="27" /></view>
          </view>
          <text class="points-available">当前可用积分：{{availablePointsLabel}}</text>
        </view>
        <view class="points-controls">
          <view wx:if="{{usePoints && preview.points_used > 0}}" class="points-used">－ {{pointsUsedLabel}} 积分</view>
          <text wx:if="{{usePoints && preview.discount_amount !== '0.00'}}" class="discount-amount">−¥{{discountAmountLabel}}</text>
          <text wx:else class="no-points">不使用积分</text>
          <view class="points-toggle {{usePoints ? 'is-on' : ''}} {{!preview || preview.max_points_usable === 0 || previewLoading ? 'is-disabled' : ''}}" bindtap="onPointsToggle">
            <view class="toggle-thumb"></view>
          </view>
        </view>
      </view>

      <view class="pay-total">
        <text>实付金额</text>
        <text>¥{{payAmountLabel || '0'}}</text>
      </view>
      <text wx:if="{{errorMessage}}" class="form-error">{{errorMessage}}</text>
      <text wx:if="{{availabilityError}}" class="form-error">{{availabilityError}}</text>
      <text wx:elif="{{availabilityVerified && availability && !availability.available}}" class="form-error">该房间在所选日期内不可订</text>
    </view>

  </view>

  <view wx:if="{{room}}" class="booking-footer">
    <button class="pay-button" disabled="{{submitting || loading || previewLoading || !preview || !availabilityVerified || !availability || !availability.available}}" bindtap="onPayTap">
      <qx-icon name="message-circle-white" size="38" />
      <text>{{submitting ? '正在锁定客房…' : payButtonLabel}}</text>
    </button>
  </view>

  <booking-calendar
    visible="{{calendarVisible}}"
    room-id="{{roomId}}"
    check-in="{{checkIn}}"
    check-out="{{checkOut}}"
    bind:close="onCalendarClose"
    bind:confirm="onCalendarConfirm" />

  <view wx:if="{{ruleVisible}}" class="rule-mask" catchtap="onPointsRuleClose">
    <view class="rule-dialog" catchtap="noop">
      <text class="rule-title">会员等级与积分规则</text>
      <view class="rule-table">
        <view class="rule-table-header">
          <text>会员等级</text>
          <text>成长积分门槛</text>
          <text>抵扣比例</text>
        </view>
        <view class="rule-table-row">
          <text class="rule-tier-name">普通会员</text>
          <text class="rule-tier-range">0 - 499</text>
          <text class="rule-tier-rate">30积分 = ¥1</text>
        </view>
        <view class="rule-table-row">
          <text class="rule-tier-name">银卡会员</text>
          <text class="rule-tier-range">500 - 999</text>
          <text class="rule-tier-rate">25积分 = ¥1</text>
        </view>
        <view class="rule-table-row">
          <text class="rule-tier-name">金卡会员</text>
          <text class="rule-tier-range">1000 - 1499</text>
          <text class="rule-tier-rate">20积分 = ¥1</text>
        </view>
        <view class="rule-table-row">
          <text class="rule-tier-name">钻石会员</text>
          <text class="rule-tier-range">≥ 1500</text>
          <text class="rule-tier-rate">15积分 = ¥1</text>
        </view>
      </view>
      <view class="rule-list">
        <view class="rule-item"><text class="rule-bullet">• </text><text><text class="rule-strong">消费获得积分：</text>订单完成后按实付金额满 ¥1 发 1 积分（向下取整）。</text></view>
        <view class="rule-item"><text class="rule-bullet">• </text><text><text class="rule-strong">单笔抵扣上限：</text>可用积分最高抵扣单笔房费的 <text class="rule-accent">20%</text>。</text></view>
        <view class="rule-item"><text class="rule-bullet">• </text><text><text class="rule-strong">取消订单返还：</text>自助取消退款成功后，已抵扣积分全额退回账户。</text></view>
        <view class="rule-item"><text class="rule-bullet">• </text><text><text class="rule-strong">永久有效保级：</text>积分不设有效期，消耗可用积分不降低会员等级。</text></view>
      </view>
      <button class="rule-close" bindtap="onPointsRuleClose">我明白了</button>
    </view>
  </view>
</view>
