.booking-page { min-height: 100vh; padding: 16rpx 32rpx calc(244rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #faf7f2; }
.booking-state { display: flex; min-height: 60vh; align-items: center; justify-content: center; color: #7a726b; font-size: 24rpx; text-align: center; }
.booking-error, .form-error { color: #b83b2a; }
.booking-card { margin-bottom: 28rpx; padding: 32rpx; border: 1rpx solid rgba(232, 224, 212, .7); border-radius: 32rpx; background: #fff; box-shadow: 0 8rpx 40rpx rgba(35, 31, 29, .05); }
.room-summary-card { padding: 28rpx; }
.room-summary-top { display: flex; align-items: center; gap: 24rpx; }
.summary-image { flex: none; width: 160rpx; height: 128rpx; border-radius: 24rpx; background: #f3ede2; }
.summary-image-empty { display: flex; align-items: center; justify-content: center; color: #8b4d25; font-family: "Songti SC", serif; font-size: 20rpx; }
.summary-room-info { display: flex; flex: 1; flex-direction: column; min-width: 0; gap: 10rpx; }
.summary-room-name { overflow: hidden; color: #231f1d; font-family: "Songti SC", "Noto Serif SC", serif; font-size: 30rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.summary-room-meta { color: #7a726b; font-size: 22rpx; }
.summary-stay-row { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(232, 224, 212, .6); }
.summary-stay-dates { display: flex; flex: 1; align-items: center; justify-content: flex-start; gap: 10rpx; min-width: 0; }
.summary-stay-dates view { white-space: nowrap; }
.summary-date-label { color: #7a726b; font-size: 22rpx; }
.summary-date-value { color: #231f1d; font-size: 23rpx; font-weight: 700; }
.summary-date-week { color: #7a726b; font-size: 21rpx; }
.summary-stay-arrow { color: #8b4d25; font-size: 22rpx; }
.summary-nights { flex: none; padding: 4rpx 20rpx; border-radius: 999rpx; color: #8b4d25; background: #f7efe8; font-size: 22rpx; font-weight: 600; }
.section-heading { display: flex; align-items: center; gap: 16rpx; color: #6f3b1a; font-family: "Songti SC", "Noto Serif SC", serif; font-size: 28rpx; font-weight: 700; }
.section-rail { width: 8rpx; height: 32rpx; border-radius: 6rpx; background: #8b4d25; }
.form-fields { display: flex; flex-direction: column; gap: 20rpx; margin-top: 24rpx; color: #231f1d; font-size: 24rpx; }
.form-row { display: flex; align-items: center; gap: 24rpx; }
.form-row label { display: flex; flex: none; align-items: center; gap: 12rpx; width: 160rpx; color: #231f1d; font-size: 24rpx; }
.required { color: #b83b2a; }
.form-row input { display: block; flex: 1; width: 0; min-width: 0; height: 72rpx; padding: 0 24rpx; box-sizing: border-box; border: 1rpx solid #e8e0d4; border-radius: 24rpx; color: #231f1d; background: rgba(250, 247, 242, .7); font-size: 24rpx; line-height: 72rpx; }
.form-row input::placeholder { color: #aaa19a; }
.guest-counter { display: flex; height: 88rpx; min-height: 44px; align-items: center; overflow: hidden; border: 1rpx solid #e8e0d4; border-radius: 22rpx; background: #fff; }
.guest-counter button { display: flex; width: 88rpx; min-width: 44px; height: 88rpx; min-height: 44px; align-items: center; justify-content: center; margin: 0; padding: 0; color: #7a726b; background: #fff; font-size: 30rpx; line-height: 1; }
.guest-counter button::after { border: 0; }
.guest-counter button[disabled] { opacity: .35; }
.guest-counter text { display: grid; width: 80rpx; height: 88rpx; min-height: 44px; place-items: center; border-right: 1rpx solid #e8e0d4; border-left: 1rpx solid #e8e0d4; color: #231f1d; font-size: 24rpx; font-weight: 700; }
.fee-card { padding-bottom: 32rpx; }
.fee-title-row { display: flex; align-items: center; justify-content: space-between; }
.tier-pill { padding: 4rpx 16rpx; border-radius: 999rpx; color: #8b4d25; background: #f7efe8; font-size: 22rpx; font-weight: 500; }
.fee-line { display: flex; align-items: center; gap: 10rpx; margin-top: 24rpx; padding: 8rpx 0 0; color: #231f1d; font-size: 24rpx; }
.fee-equation { flex: 1; color: #7a726b; text-align: right; }
.fee-value { min-width: 108rpx; color: #231f1d; font-weight: 700; text-align: right; }
.fee-loading { margin-top: 22rpx; color: #7a726b; font-size: 24rpx; }
.points-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 24rpx; padding: 20rpx 0 0; border-top: 1rpx solid rgba(232, 224, 212, .6); }
.points-description { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 6rpx; }
.points-title-row { display: flex; align-items: center; gap: 7rpx; color: #231f1d; font-size: 24rpx; white-space: nowrap; }
.points-title { flex: none; white-space: nowrap; }
.points-help { display: flex; flex: 0 0 88rpx; width: 88rpx; min-width: 44px; max-width: 88rpx; height: 88rpx; min-height: 44px; align-items: center; justify-content: center; box-sizing: border-box; }
.points-available { color: #7a726b; font-size: 22rpx; white-space: nowrap; }
.points-controls { display: flex; flex: none; align-items: center; gap: 10rpx; }
.points-used { padding: 8rpx 20rpx; border-radius: 16rpx; color: #8b4d25; background: #f7efe8; font-size: 22rpx; font-weight: 600; white-space: nowrap; }
.discount-amount { color: #b83b2a; font-size: 24rpx; font-weight: 700; white-space: nowrap; }
.no-points { color: #7a726b; font-size: 22rpx; white-space: nowrap; }
.points-toggle { position: relative; display: block; flex: 0 0 88rpx; width: 88rpx; min-width: 44px; max-width: 88rpx; height: 88rpx; min-height: 44px; box-sizing: border-box; background: transparent; }
.points-toggle::before { position: absolute; top: 50%; left: 50%; width: 80rpx; height: 44rpx; border-radius: 999rpx; background: #e8e0d4; content: ''; transform: translate(-50%, -50%); transition: background .18s ease; }
.points-toggle.is-on::before { background: #8b4d25; }
.toggle-thumb { position: absolute; top: 50%; left: calc(50% - 36rpx); width: 36rpx; height: 36rpx; border-radius: 50%; background: #fff; box-shadow: 0 2rpx 7rpx rgba(35, 31, 29, .18); transform: translateY(-50%); transition: transform .18s ease; }
.points-toggle.is-on .toggle-thumb { transform: translate(36rpx, -50%); }
.points-toggle.is-disabled { opacity: .45; }
.pay-total { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; padding: 28rpx 24rpx; border-radius: 24rpx; background: #f7efe8; color: #6f3b1a; font-family: "Songti SC", "Noto Serif SC", serif; font-size: 28rpx; font-weight: 700; }
.pay-total text:last-child { color: #b83b2a; font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 40rpx; }
.form-error { display: block; margin-top: 16rpx; font-size: 24rpx; line-height: 1.5; }
.booking-note { display: block; margin: 4rpx 8rpx 18rpx; color: #7a726b; font-size: 18rpx; line-height: 1.5; }
.booking-footer { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e8e0d4; background: rgba(255, 255, 255, .96); box-shadow: 0 -12rpx 40rpx rgba(35, 31, 29, .05); }
.booking-footer .pay-button { display: flex; width: 100%; height: 96rpx; min-height: 44px; align-items: center; justify-content: center; gap: 16rpx; box-sizing: border-box; margin: 0; padding: 0 32rpx; border-radius: 32rpx; color: #fff; background: #8b4d25; box-shadow: 0 8rpx 24rpx rgba(139, 77, 37, .14); font-size: 30rpx; font-weight: 500; line-height: 1; }
.booking-footer .pay-button::after { border: 0; }
.booking-footer .pay-button[disabled] { opacity: .58; }
.rule-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 1200; display: flex; align-items: center; justify-content: center; padding: 48rpx; box-sizing: border-box; background: rgba(35, 31, 29, .5); }
.rule-dialog { width: 100%; max-width: 650rpx; padding: 48rpx; box-sizing: border-box; border: 2rpx solid #e8e0d4; border-radius: 48rpx; background: #fff; box-shadow: 0 24rpx 64rpx rgba(35, 31, 29, .2); }
.rule-title { display: block; color: #231f1d; font-family: "Songti SC", "Noto Serif SC", serif; font-size: 32rpx; font-weight: 700; }
.rule-table { overflow: hidden; margin-top: 24rpx; border: 2rpx solid #e8e0d4; border-radius: 24rpx; font-size: 22rpx; }
.rule-table-header, .rule-table-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: center; text-align: center; padding: 16rpx 8rpx; }
.rule-table-header { color: #8b4d25; background: #f7efe8; font-weight: 700; }
.rule-table-row { border-top: 2rpx solid rgba(232, 224, 212, .6); }
.rule-tier-name { color: #231f1d; font-weight: 500; }
.rule-tier-range { color: #7a726b; }
.rule-tier-rate { color: #8b4d25; font-weight: 600; }
.rule-list { display: flex; flex-direction: column; gap: 12rpx; margin-top: 28rpx; color: #7a726b; font-size: 22rpx; line-height: 1.6; }
.rule-item { display: flex; align-items: flex-start; }
.rule-bullet { flex: none; }
.rule-strong { color: #231f1d; font-weight: 700; }
.rule-accent { color: #b83b2a; font-weight: 600; }
.rule-dialog .rule-close { display: flex; width: 100%; height: 80rpx; align-items: center; justify-content: center; box-sizing: border-box; margin: 36rpx 0 0; padding: 0; border-radius: 24rpx; color: #fff; background: #8b4d25; font-size: 24rpx; font-weight: 500; line-height: 1; }
.rule-dialog .rule-close::after { border: 0; }
