<view class="payment-page">
  <view class="payment-card">
    <view class="payment-icon-wrap">
      <image class="payment-icon" src="/assets/payment-wallet.svg" mode="aspectFit" />
    </view>
    <text class="payment-title">订单待支付</text>
    <text wx:if="{{paymentMethod === 'WECHAT'}}" class="payment-note">微信安全支付</text>
    <view class="amount-main"><text>¥</text><text>{{payAmount}}</text></view>
    <view class="amount-detail">
      <view><text>房费原价</text><text>¥{{roomAmount}}</text></view>
      <view><text>积分抵扣（{{pointsUsed}} 分）</text><text>− ¥{{discountAmount}}</text></view>
    </view>
    <view class="countdown-row"><text>订单剩余支付时间</text><text>{{countdown}}</text></view>
    <view wx:if="{{status === 'CLOSED'}}" class="payment-state is-closed">支付已关闭</view>
    <view wx:elif="{{status === 'SUCCESS'}}" class="payment-state is-success">支付成功，正在确认订单…</view>
    <view wx:elif="{{message}}" class="payment-message">{{message}}</view>
    <button wx:if="{{paymentMethod === 'WECHAT'}}" class="pay-button" open-type="getPhoneNumber" disabled="{{paying || checking || status === 'CLOSED' || status === 'SUCCESS'}}" bindgetphonenumber="onPhoneAuthorized">{{paying ? '正在发起支付…' : '微信支付'}}</button>
    <button wx:else class="pay-button" disabled="{{paying || checking || status === 'CLOSED' || status === 'SUCCESS'}}" bindtap="onPayTap">{{paying ? '正在确认支付…' : '立即支付'}}</button>
    <button class="status-button" disabled="{{checking}}" bindtap="refreshPaymentState">{{checking ? '查询中…' : '查询支付状态'}}</button>
  </view>
</view>
