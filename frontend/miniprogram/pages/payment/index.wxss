.payment-page { display: flex; min-height: 100vh; align-items: flex-start; justify-content: center; padding: 48rpx 28rpx; box-sizing: border-box; background: #fbf5ef; }
.payment-card { width: 100%; padding: 38rpx 28rpx 30rpx; box-sizing: border-box; border: 1rpx solid #eee3d8; border-radius: 18rpx; background: #fffcf9; box-shadow: 0 12rpx 34rpx rgba(78, 54, 34, .06); text-align: center; }
.payment-seal { display: grid; width: 74rpx; height: 74rpx; place-items: center; margin: 0 auto; border: 2rpx solid #c79a70; border-radius: 50%; color: #98501f; font-family: serif; font-size: 34rpx; }
.payment-title { display: block; margin-top: 17rpx; color: #512a18; font-family: serif; font-size: 30rpx; font-weight: 600; }
.payment-note { display: block; margin-top: 9rpx; color: #a09284; font-size: 18rpx; }
.amount-main { display: flex; align-items: baseline; justify-content: center; margin-top: 30rpx; color: #d74332; }
.amount-main text:first-child { margin-right: 7rpx; font-size: 26rpx; }
.amount-main text:last-child { font-family: Georgia, serif; font-size: 55rpx; font-weight: 600; }
.amount-detail { margin-top: 22rpx; padding: 14rpx 5rpx; border-top: 1rpx solid #f0e8df; border-bottom: 1rpx solid #f0e8df; }
.amount-detail view, .countdown-row { display: flex; min-height: 50rpx; align-items: center; justify-content: space-between; color: #8b7c6e; font-size: 20rpx; }
.amount-detail view text:last-child { color: #5c4c40; }
.countdown-row { margin: 16rpx 0 10rpx; }
.countdown-row text:last-child { color: #98501f; font-family: Georgia, serif; font-size: 26rpx; font-weight: 600; }
.payment-state, .payment-message { margin: 10rpx 0; padding: 13rpx; border-radius: 8rpx; color: #8b6844; background: #f7efe6; font-size: 19rpx; line-height: 1.5; }
.payment-state.is-closed { color: #a14439; background: #fbefeb; }
.payment-state.is-success { color: #537250; background: #eff5ec; }
.payment-message { color: #a14439; }
.pay-button { width: 100%; height: 80rpx; margin-top: 17rpx; border: 0; border-radius: 10rpx; color: #fffaf4; background: #98501f; font-size: 23rpx; line-height: 80rpx; }
.pay-button[disabled] { opacity: .55; }
.pay-button::after { border: 0; }
.status-button { width: 100%; height: 72rpx; margin-top: 12rpx; border: 1rpx solid #decdbc; border-radius: 10rpx; color: #795b43; background: #fffdfa; font-size: 21rpx; line-height: 70rpx; }
.status-button::after { border: 0; }
