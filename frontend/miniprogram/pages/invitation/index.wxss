.page { min-height:100vh; box-sizing:border-box; padding:32rpx 32rpx 80rpx; background:#fbf5ef; color:#292522; }
.hero { position:relative; height:300rpx; overflow:hidden; border-radius:32rpx; background:#f5e5d6; }
.hero image { width:100%; height:100%; opacity:.55; }
.hero-text { position:absolute; left:32rpx; bottom:30rpx; display:flex; flex-direction:column; gap:12rpx; color:#512a18; }
.title { font-size:42rpx; font-weight:600; }.subtitle { font-size:25rpx; }
.share { margin:32rpx 0; border-radius:32rpx; color:#fff; background:#98501f; font-size:32rpx; }.share::after { border:0; }.disabled { opacity:.5; }
.card { padding:32rpx; background:#fffcf9; border-radius:32rpx; }.heading { display:flex; justify-content:space-between; font-weight:600; }.count { color:#98501f; }
.record { display:flex; justify-content:space-between; padding:28rpx 0; border-bottom:1rpx solid #efe5dc; }.time,.state { color:#7a726b; font-size:26rpx; }.state { padding:50rpx 0; text-align:center; }
