.intro-page { min-height: 100vh; padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); box-sizing: border-box; color: #292522; background: #fbf5ef; }
.intro-hero { position: relative; height: 440rpx; overflow: hidden; }
.intro-hero-image,.intro-hero-wash { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; }
.intro-hero-image { object-fit: cover; object-position: center; }
/* 门头实拍明暗差较大，顶部压暗保证原品牌文字可读。 */
.intro-hero-wash { background: linear-gradient(180deg, rgba(38, 28, 20, .42) 0%, rgba(38, 28, 20, .52) 39%, rgba(38, 28, 20, .06) 74%, #fbf5ef 100%); }
.intro-hero-copy { position: absolute; top: 90rpx; left: 0; display: flex; width: 100%; flex-direction: column; align-items: center; color: #fffaf2; text-shadow: 0 3rpx 16rpx rgba(47, 31, 20, .45); }
.intro-eyebrow { color: rgba(255, 250, 242, .9); font-size: 19rpx; font-weight: 600; letter-spacing: 5rpx; }
.intro-brand { margin-top: 14rpx; font-family: "Songti SC", "Noto Serif SC", serif; font-size: 58rpx; font-weight: 700; letter-spacing: 8rpx; }
.intro-tagline { margin-top: 10rpx; font-size: 24rpx; letter-spacing: 5rpx; }
.intro-content { position: relative; z-index: 1; margin-top: -54rpx; padding: 0 32rpx; }
.card { border: 1rpx solid rgba(232, 215, 199, .85); border-radius: 36rpx; background: #fffcf8; box-shadow: 0 12rpx 34rpx rgba(95, 60, 36, .07); }
.intro-story { padding: 30rpx 32rpx; }
.story-title { display: block; color: #512a18; font-family: "Songti SC", "Noto Serif SC", serif; font-size: 38rpx; font-weight: 700; letter-spacing: 1rpx; }
.story-body { display: block; margin-top: 14rpx; color: #62574f; font-size: 26rpx; line-height: 1.75; }
.section-block { margin-top: 36rpx; }
.section-title { display: block; padding-left: 16rpx; border-left: 5rpx solid #8b4d25; color: #512a18; font-family: "Songti SC", "Noto Serif SC", serif; font-size: 34rpx; line-height: 1.15; font-weight: 700; }
.courtyard-card { margin-top: 20rpx; overflow: hidden; }
.courtyard-image { display: block; width: 100%; aspect-ratio: 16 / 9; background: #f7ede3; }
.courtyard-caption { display: block; padding: 20rpx 26rpx 24rpx; color: #62574f; font-size: 24rpx; line-height: 1.65; }
.feature-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; margin-top: 20rpx; }
.feature-card { display: flex; min-height: 164rpx; flex-direction: column; align-items: center; justify-content: center; padding: 20rpx 8rpx; border: 1rpx solid #eee1d5; border-radius: 26rpx; box-sizing: border-box; background: #fffcf8; }
.feature-icon { display: flex; width: 64rpx; height: 64rpx; align-items: center; justify-content: center; border-radius: 50%; background: #f7ede3; }
.feature-title { margin-top: 14rpx; color: #51301d; font-size: 24rpx; font-weight: 600; }
.feature-caption { margin-top: 6rpx; color: #6e6257; font-size: 22rpx; text-align: center; }
.walk-card, .location-card { margin-top: 20rpx; padding: 26rpx; border: 1rpx solid #eadccf; border-radius: 30rpx; background: #fffcf8; }
.walk-body { display: block; color: #62574f; font-size: 25rpx; line-height: 1.7; }
.walk-sites { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 16rpx; }
.site-chip { padding: 7rpx 14rpx; border: 1rpx solid #eee1d5; border-radius: 999rpx; color: #8b4d25; background: #faf3ec; font-size: 22rpx; }
.location-topline { display: flex; align-items: center; gap: 12rpx; }
.location-pin { display: flex; width: 58rpx; height: 58rpx; align-items: center; justify-content: center; border-radius: 50%; color: #8b4d25; background: #f7ede3; }
.location-label { color: #897c70; font-size: 21rpx; }
.location-address { display: block; margin-top: 16rpx; color: #512a18; font-size: 28rpx; font-weight: 600; }
.location-transit { display: block; margin-top: 12rpx; color: #6e6257; font-size: 24rpx; line-height: 1.65; }
.location-actions { display: flex; gap: 14rpx; margin-top: 22rpx; }
.location-action { display: flex; flex: 1; height: 78rpx; min-height: 44px; align-items: center; justify-content: center; margin: 0; padding: 0; border-radius: 999rpx; font-size: 24rpx; line-height: 1; }
.location-action::after { border: 0; }
.location-copy { border: 1rpx solid #e6d3c0; color: #80502f; background: #fbf5ef; }
.location-call { color: #fffaf4; background: #8b4d25; }
.intro-bottom-bar { position: fixed; z-index: 5; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid rgba(232, 215, 199, .75); background: rgba(255, 252, 248, .96); box-shadow: 0 -8rpx 24rpx rgba(67, 43, 28, .05); }
.bottom-hint { flex: 1; color: #897c70; font-size: 20rpx; }
.rooms-button { display: flex; width: 220rpx; height: 76rpx; min-height: 44px; flex-shrink: 0; align-items: center; justify-content: center; margin: 0; padding: 0; border-radius: 999rpx; color: #fffaf4; background: #8b4d25; box-shadow: 0 6rpx 16rpx rgba(139, 77, 37, .16); font-size: 25rpx; font-weight: 600; line-height: 1; }
.rooms-button::after { border: 0; }
.rooms-button-hover { opacity: .88; }
