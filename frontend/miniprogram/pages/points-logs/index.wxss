.logs-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 16rpx 32rpx calc(64rpx + env(safe-area-inset-bottom));
  color: #231f1d;
  background: #faf7f2;
}

.summary-card {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: center;
  padding: 32rpx;
  border: 2rpx solid rgba(232, 224, 212, 0.7);
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 40rpx -4rpx rgba(35, 31, 29, 0.05);
}

.summary-left {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 24rpx;
  padding-right: 16rpx;
}

.summary-icon-circle {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  flex: 0 0 80rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f7efe8;
}

.summary-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.summary-label {
  color: #7a726b;
  font-size: 22rpx;
}

.summary-value {
  margin-top: 4rpx;
  color: #8b4d25;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
}

.summary-right {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  padding-left: 28rpx;
  border-left: 2rpx solid rgba(232, 224, 212, 0.7);
}

.summary-right-main {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 16rpx;
}

.summary-usage {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.summary-usage-title {
  color: #231f1d;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}

.summary-usage-desc {
  margin-top: 4rpx;
  color: #7a726b;
  font-size: 20rpx;
  white-space: nowrap;
}

.logs-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 32rpx 0 24rpx;
}

.heading-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.heading-mark {
  width: 8rpx;
  height: 32rpx;
  border-radius: 8rpx;
  background: #8b4d25;
}

.heading-title {
  color: #6f3b1a;
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 28rpx;
  font-weight: 700;
}

.heading-count {
  color: #7a726b;
  font-size: 22rpx;
}

.month-groups {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.month-card {
  overflow: hidden;
  border: 2rpx solid rgba(232, 224, 212, 0.7);
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 40rpx -4rpx rgba(35, 31, 29, 0.05);
}

.month-header {
  padding: 16rpx 32rpx;
  border-bottom: 2rpx solid rgba(232, 224, 212, 0.6);
  color: #6f3b1a;
  background: rgba(247, 239, 232, 0.8);
  font-size: 24rpx;
  font-weight: 700;
}

.month-list {
  display: flex;
  flex-direction: column;
}

.log-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 32rpx;
}

.log-row + .log-row {
  border-top: 2rpx solid rgba(232, 224, 212, 0.6);
}

.log-left {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  gap: 24rpx;
}

.log-icon-wrap {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 72rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.log-icon-wrap.is-positive {
  background: #ebf2ee;
}

.log-icon-wrap.is-negative {
  background: #f7efe8;
}

.log-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.log-title {
  overflow: hidden;
  color: #231f1d;
  font-size: 24rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.log-source {
  overflow: hidden;
  margin-top: 4rpx;
  color: #7a726b;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.log-meta {
  margin-top: 4rpx;
  color: rgba(122, 114, 107, 0.8);
  font-size: 20rpx;
}

.log-delta {
  flex: 0 0 auto;
  margin-left: 16rpx;
  font-family: monospace;
  font-size: 30rpx;
  font-weight: 700;
}

.delta-positive {
  color: #4e7a65;
}

.delta-negative {
  color: #b83b2a;
}

.logs-state,
.logs-empty {
  display: flex;
  min-height: 260rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 40rpx;
  border: 2rpx solid rgba(232, 224, 212, 0.7);
  border-radius: 32rpx;
  color: #7a726b;
  background: #ffffff;
  font-size: 24rpx;
  text-align: center;
}

.logs-error {
  color: #b83b2a;
}

.empty-title {
  color: #231f1d;
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 28rpx;
  font-weight: 700;
}

.empty-desc {
  color: #7a726b;
  font-size: 22rpx;
}

.retry-button {
  min-height: 68rpx;
  margin: 0;
  padding: 0 32rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #8b4d25;
  font-size: 24rpx;
  line-height: 68rpx;
}

.retry-button::after,
.back-member-button::after,
.rule-close::after {
  border: 0;
}

.logs-footer {
  padding: 12rpx 0;
  color: #7a726b;
  font-size: 22rpx;
  text-align: center;
}

.logs-page .back-member-button {
  display: flex;
  width: 100%;
  height: 84rpx;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
  margin: 32rpx 0 0;
  padding: 0 32rpx;
  border: 2rpx solid #8b4d25;
  border-radius: 999rpx;
  color: #8b4d25;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(35, 31, 29, 0.04);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
}

.rule-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  background: rgba(35, 31, 29, 0.5);
}

.rule-dialog {
  width: 100%;
  max-width: 650rpx;
  padding: 48rpx;
  box-sizing: border-box;
  border: 2rpx solid #e8e0d4;
  border-radius: 48rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 64rpx rgba(35, 31, 29, 0.2);
}

.rule-title {
  display: block;
  color: #231f1d;
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 32rpx;
  font-weight: 700;
}

.rule-table {
  overflow: hidden;
  margin-top: 24rpx;
  border: 2rpx solid #e8e0d4;
  border-radius: 24rpx;
  font-size: 22rpx;
}

.rule-table-header,
.rule-table-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: center;
  text-align: center;
  padding: 16rpx 8rpx;
}

.rule-table-header {
  color: #8b4d25;
  background: #f7efe8;
  font-weight: 700;
}

.rule-table-row {
  border-top: 2rpx solid rgba(232, 224, 212, 0.6);
}

.rule-tier-name {
  color: #231f1d;
  font-weight: 500;
}

.rule-tier-range {
  color: #7a726b;
}

.rule-tier-rate {
  color: #8b4d25;
  font-weight: 600;
}

.rule-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 28rpx;
  color: #7a726b;
  font-size: 22rpx;
  line-height: 1.6;
}

.rule-item {
  display: flex;
  align-items: flex-start;
}

.rule-bullet {
  flex: none;
}

.rule-strong {
  color: #231f1d;
  font-weight: 700;
}

.rule-accent {
  color: #b83b2a;
  font-weight: 600;
}

.rule-dialog .rule-close {
  display: flex;
  width: 100%;
  height: 80rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 36rpx 0 0;
  padding: 0;
  border-radius: 24rpx;
  color: #ffffff;
  background: #8b4d25;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
}

/* 浅色水乡装饰不参与布局，也不遮挡流水操作。 */
.logs-page { position:relative; overflow:hidden; background:linear-gradient(#faecde,#faf7f2 480rpx); }
.logs-bottom-art { position:absolute; bottom:0; left:0; width:100%; height:200rpx; opacity:.35; pointer-events:none; }
.summary-card,.logs-heading,.month-groups,.logs-state,.logs-empty,.back-member-button { position:relative; }
.summary-card,.month-card { background:#fffcf9; border-color:rgba(255,255,255,.85); }
.summary-label { color:#55463c; }
.summary-value,.log-delta { font-family:serif; }
.month-header { position:relative; background:#f7e9da; font-family:serif; font-size:27rpx; }
.log-row { padding:25rpx 28rpx; }
.log-title { font-size:26rpx; }
.log-meta { color:#7a726b; font-size:21rpx; }
.log-icon-wrap.is-negative { background:#faeadb; }
.log-icon-wrap.is-positive { background:#ecf2e9; }
.rule-dialog { max-height:calc(100vh - 80rpx); overflow-y:auto; }
