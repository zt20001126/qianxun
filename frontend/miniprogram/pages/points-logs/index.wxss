.logs-page { min-height: 100vh; padding: 28rpx; color: #292522; background: #fbf5ef; }
.logs-heading { display: flex; align-items: baseline; justify-content: space-between; margin: 6rpx 4rpx 22rpx; color: #512a18; font-size: 30rpx; font-weight: 600; }
.logs-heading text:last-child { color: #9a8d80; font-size: 21rpx; font-weight: 400; }
.logs-card { overflow: hidden; border: 1rpx solid #eee4da; border-radius: 18rpx; background: #fffcf9; }
.log-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 24rpx 22rpx; border-bottom: 1rpx solid #f1eae2; }
.log-main { display: grid; min-width: 0; flex: 1; gap: 9rpx; }
.log-title { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; color: #4b4036; font-size: 25rpx; font-weight: 600; }
.log-points { flex: 0 0 auto; font-family: Georgia, serif; font-size: 27rpx; }
.positive { color: #69834d; }
.negative { color: #b34b3b; }
.log-source { overflow: hidden; color: #81756a; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.log-time { color: #a3988d; font-size: 19rpx; }
.log-balance { display: grid; flex: 0 0 90rpx; justify-items: end; gap: 7rpx; color: #a3988d; font-size: 19rpx; }
.log-balance text:last-child { color: #624b38; font-family: Georgia, serif; font-size: 23rpx; }
.logs-state { display: grid; min-height: 270rpx; align-content: center; justify-items: center; gap: 20rpx; color: #94877b; font-size: 24rpx; }
.logs-error { color: #a1483b; }
.retry-button { min-height: 66rpx; padding: 0 25rpx; border-radius: 11rpx; color: #fffaf5; background: #98501f; font-size: 22rpx; }
.logs-footer { padding: 24rpx; color: #a3988d; font-size: 20rpx; text-align: center; }
