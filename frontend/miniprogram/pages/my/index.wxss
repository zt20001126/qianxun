.my-page {
  min-height:100vh;
  box-sizing:border-box;
  padding:24rpx 40rpx 64rpx;
  color:#231f1d;
  background:#faf7f2
}

.my-modules {
  display:flex;
  flex-direction:column
}


.profile-card {
  position:relative;
  display:flex;
  min-height:216rpx;
  box-sizing:border-box;
  align-items:center;
  overflow:hidden;
  padding:32rpx;
  border:2rpx solid rgba(255,255,255,.65);
  border-radius:40rpx;
  background:linear-gradient(110deg,#ad7957,#754327 62%,#a77b5b)
}


.profile-background,.profile-gradient {
  position:absolute;
  top:0;
  right:0;
  width:60%;
  height:100%;
  pointer-events:none
}

.profile-background {
  opacity:.38
}

.profile-gradient {
  background:linear-gradient(to right,#865337,rgba(134,83,55,.12))
}


.profile-main {
  position:relative;
  z-index:1;
  display:flex;
  flex:1;
  min-width:0;
  align-items:center;
  gap:26rpx
}

.profile-avatar {
  width:124rpx;
  height:124rpx;
  flex:0 0 124rpx;
  box-sizing:border-box;
  border:4rpx solid #fffaf4;
  border-radius:50%;
  background:#f3ede2
}


.profile-copy,.profile-identity {
  display:flex;
  min-width:0;
  flex-direction:column
}

.profile-copy {
  flex:1
}

.profile-name {
  overflow:hidden;
  color:#fffaf5;
  font-size:36rpx;
  font-weight:600;
  text-overflow:ellipsis;
  white-space:nowrap
}

.profile-phone {
  margin-top:4rpx;
  color:#f2dfd0;
  font-size:24rpx
}


.profile-level {
  display:flex;
  align-self:flex-start;
  align-items:center;
  gap:8rpx;
  margin-top:12rpx;
  padding:4rpx 16rpx;
  border:2rpx solid #fbe6c5;
  border-radius:999rpx;
  background:rgba(96,48,22,.65)
}

.crown-icon {
  width:26rpx;
  height:26rpx
}

.profile-level-name {
  color:#fbe6c5;
  font-size:22rpx;
  white-space:nowrap
}

.profile-watermark {
  position:absolute;
  right:28rpx;
  bottom:24rpx;
  width:86rpx;
  height:86rpx;
  opacity:.48
}


.contact-list {
  margin-top:32rpx;
  padding:0 20rpx;
  overflow:hidden;
  border:2rpx solid #f0e7df;
  border-radius:36rpx;
  background:#fff;
  box-shadow:0 8rpx 28rpx rgba(79,49,30,.04)
}

.contact-card {
  display:flex;
  min-height:144rpx;
  box-sizing:border-box;
  align-items:center;
  justify-content:space-between;
  padding:20rpx 10rpx;
  border-bottom:1rpx solid #e9e1db
}

.contact-card:last-child {
  border-bottom:0
}


.contact-main {
  display:flex;
  min-width:0;
  flex:1;
  align-items:center;
  gap:24rpx
}

.contact-icon-box {
  display:flex;
  width:84rpx;
  height:84rpx;
  flex:0 0 84rpx;
  align-items:center;
  justify-content:center;
  border-radius:24rpx;
  background:#faede1
}

.contact-icon {
  width:42rpx;
  height:42rpx
}

.contact-copy {
  display:flex;
  min-width:0;
  flex-direction:column
}

.contact-title {
  color:#231f1d;
  font-size:29rpx;
  font-weight:600
}

.contact-phone {
  overflow:hidden;
  margin-top:6rpx;
  color:#7a726b;
  font-size:24rpx;
  text-overflow:ellipsis;
  white-space:nowrap
}


.contact-arrow {
  position:relative;
  width:32rpx;
  height:32rpx;
  flex:0 0 32rpx
}

.contact-arrow::after {
  position:absolute;
  top:8rpx;
  left:6rpx;
  width:14rpx;
  height:14rpx;
  border-top:2rpx solid #7a726b;
  border-right:2rpx solid #7a726b;
  content:'';
  transform:rotate(45deg)
}


.logout-button {
  display:flex;
  width:58%;
  box-sizing:border-box;
  align-items:center;
  justify-content:center;
  gap:12rpx;
  margin:56rpx auto 0;
  padding:16rpx 0;
  border:2rpx solid #d6b9a4;
  border-radius:999rpx;
  color:#8b4d25;
  background:transparent;
  font-size:27rpx;
  line-height:1.5
}

.logout-button::after {
  border:0
}

.logout-icon {
  width:32rpx;
  height:32rpx
}


