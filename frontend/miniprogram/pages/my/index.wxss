.my-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 16rpx 32rpx;
  color: #231f1d;
  background: #faf7f2;
}

.my-modules {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.profile-card,
.contact-card {
  position: relative;
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  overflow: hidden;
  border: 2rpx solid rgba(232, 224, 212, 0.7);
  background: #ffffff;
  box-shadow: 0 8rpx 40rpx -4rpx rgba(35, 31, 29, 0.05);
}

.profile-card {
  min-height: 208rpx;
  padding: 40rpx;
  border-radius: 48rpx;
}

.profile-background,
.profile-gradient {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 352rpx;
  height: 100%;
  pointer-events: none;
}

.profile-background {
  opacity: 0.25;
}

.profile-gradient {
  background: linear-gradient(to right, #ffffff 0%, rgba(255, 255, 255, 0.95) 55%, rgba(255, 255, 255, 0) 100%);
}

.profile-main {
  position: relative;
  z-index: 10;
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
  gap: 28rpx;
}

.profile-avatar {
  width: 124rpx;
  height: 124rpx;
  flex: 0 0 124rpx;
  box-sizing: border-box;
  border: 4rpx solid #f3ede2;
  border-radius: 50%;
  background: #f3ede2;
}

.profile-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.profile-identity {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 16rpx;
}

.profile-name {
  overflow: hidden;
  color: #231f1d;
  font-family: serif;
  font-size: 36rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-phone {
  flex: 0 0 auto;
  color: #7a726b;
  font-family: monospace;
  font-size: 22rpx;
}

.profile-level {
  display: inline-flex;
  align-self: flex-start;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  padding: 4rpx 24rpx;
  border-radius: 9999rpx;
  background: #8b4d25;
}

.crown-icon {
  width: 24rpx;
  height: 24rpx;
  flex: 0 0 24rpx;
}

.profile-level-name {
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 500;
  white-space: nowrap;
}

.profile-arrow,
.contact-arrow {
  position: relative;
  z-index: 10;
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
}

.profile-arrow::after,
.contact-arrow::after {
  position: absolute;
  top: 8rpx;
  left: 6rpx;
  width: 14rpx;
  height: 14rpx;
  border-top: 2rpx solid #8b4d25;
  border-right: 2rpx solid #8b4d25;
  content: '';
  transform: rotate(45deg);
}

.contact-card {
  padding: 32rpx;
  border-radius: 32rpx;
}

.contact-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.contact-icon-box {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #f7efe8;
}

.contact-icon {
  width: 32rpx;
  height: 32rpx;
}

.contact-copy {
  display: flex;
  flex-direction: column;
}

.contact-title {
  color: #231f1d;
  font-size: 24rpx;
  font-weight: 600;
}

.contact-phone {
  margin-top: 4rpx;
  color: #7a726b;
  font-size: 22rpx;
}

.contact-arrow::after {
  border-color: #7a726b;
}

.logout-button {
  box-sizing: border-box;
  width: 100%;
  margin: 0;
  padding: 24rpx 0;
  border: 2rpx solid #e8e0d4;
  border-radius: 32rpx;
  color: #7a726b;
  background: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.5;
  text-align: center;
}

.logout-button::after {
  border: 0;
}
