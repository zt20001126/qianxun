.my-page { position:relative; min-height:100vh; overflow:hidden; box-sizing:border-box; color:#231f1d; background:#faf7f2; }
.page-scene,.page-scene-fade { position:absolute; top:0; left:0; width:100%; height:520rpx; pointer-events:none; }
.page-scene-fade { background:linear-gradient(to bottom,rgba(250,247,242,.05) 48%,#faf7f2 100%); }
.page-footer { position:absolute; left:0; right:0; bottom:0; height:260rpx; opacity:.38; overflow:hidden; pointer-events:none; }
.footer-image,.footer-fade { position:absolute; width:100%; height:100%; }
.footer-fade { background:linear-gradient(to bottom,#faf7f2,rgba(250,247,242,.68)); }
.my-navigation { position:relative; z-index:1; box-sizing:content-box; display:flex; align-items:center; justify-content:center; color:#16110f; font-size:36rpx; font-weight:600; }
.my-modules { position:relative; z-index:1; padding:170rpx 32rpx 110rpx; }

/* 会员卡：深茶棕卡面叠加水乡建筑暗纹，标题、资料与等级分三层排列。 */
.profile-card { position:relative; display:flex; flex-direction:column; min-height:348rpx; overflow:hidden; box-sizing:border-box; padding:34rpx 42rpx 36rpx; border:2rpx solid #a7805d; border-radius:32rpx; background:#4a2d1d; box-shadow:0 20rpx 50rpx rgba(52,36,24,.26); }
.card-bg { position:absolute; top:0; left:0; width:100%; height:100%; pointer-events:none; }
.card-heading { position:relative; z-index:1; display:flex; justify-content:space-between; align-items:center; line-height:1.1; color:#efcf9a; }
.card-brand { font-family:"Songti SC",serif; font-size:38rpx; font-weight:700; letter-spacing:4rpx; }
.card-label { padding-bottom:6rpx; border-bottom:1rpx solid rgba(200,157,103,.55); font-size:22rpx; letter-spacing:4rpx; }
.profile-main { position:relative; z-index:1; display:flex; align-items:center; min-width:0; gap:12rpx; margin-top:34rpx; }
.profile-avatar { width:84rpx; height:84rpx; flex:none; border:2rpx solid rgba(224,186,130,.64); border-radius:50%; background:#f3ede2; }
.profile-copy { display:flex; min-width:0; flex-direction:column; align-items:flex-start; }
.profile-name { max-width:310rpx; overflow:hidden; color:#fffaf1; font-size:40rpx; font-weight:600; line-height:1.22; text-overflow:ellipsis; white-space:nowrap; }
.profile-phone { margin-top:4rpx; color:#e5c8a7; font-size:24rpx; }
.profile-level { position:relative; z-index:1; display:flex; align-items:center; align-self:flex-start; gap:10rpx; margin-top:auto; padding:22rpx 0 0; border:0; color:#efcf9a; background:transparent; font-size:24rpx; font-weight:600; line-height:1; white-space:nowrap; }
.crown-icon { width:26rpx; height:26rpx; flex:none; }

.contact-list { margin-top:32rpx; border-radius:36rpx; box-shadow:0 12rpx 30rpx rgba(93,56,31,.08); }
.contact-card { position:relative; display:flex; min-height:130rpx; box-sizing:border-box; align-items:center; justify-content:space-between; overflow:hidden; padding:20rpx 30rpx; border:2rpx solid rgba(255,255,255,.95); border-radius:34rpx; background:rgba(255,252,249,.8); }
.contact-card + .contact-card { margin-top:-2rpx; }
.card-pressed { opacity:.82; }
.contact-main { position:relative; z-index:1; display:flex; flex:1; min-width:0; align-items:center; gap:26rpx; }
.contact-icon-box { display:flex; width:92rpx; height:92rpx; flex:none; align-items:center; justify-content:center; border-radius:50%; background:#f8e9dc; }
.contact-icon { width:48rpx; height:48rpx; }
.contact-copy { display:flex; min-width:0; flex-direction:column; }
.contact-title { color:#231f1d; font-size:31rpx; font-weight:600; }
.contact-phone { overflow:hidden; margin-top:4rpx; color:#6e5d52; font-size:24rpx; text-overflow:ellipsis; white-space:nowrap; }
.contact-art { position:absolute; right:74rpx; bottom:4rpx; width:145rpx; height:110rpx; opacity:.10; }
.bridge-art { width:230rpx; opacity:.34; }
.bamboo-art { width:150rpx; height:120rpx; opacity:.2; }
.contact-arrow { z-index:1; width:16rpx; height:16rpx; flex:none; margin-left:8rpx; border-top:3rpx solid #8b4d25; border-right:3rpx solid #8b4d25; transform:rotate(45deg); }
.logout-button { display:flex; width:100%; align-items:center; justify-content:center; gap:12rpx; margin:52rpx auto 0; padding:12rpx 0; border:0; color:#8b5b3d; background:transparent; font-size:28rpx; line-height:1.5; }
/* 文字保持单行，空间不足时由两侧装饰线收缩。 */
.logout-button text { flex:none; white-space:nowrap; }
.logout-line { width:110rpx; min-width:0; height:1rpx; margin-right:34rpx; background:linear-gradient(to right,transparent,#c89167); }
.logout-line-right { margin-right:0; margin-left:34rpx; background:linear-gradient(to left,transparent,#c89167); }
.logout-icon { flex:none; width:32rpx; height:32rpx; }
