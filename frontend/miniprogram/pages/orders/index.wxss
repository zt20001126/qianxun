.orders-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 16rpx 32rpx 64rpx;
  color: #231f1d;
  background: #faf7f2;
}

.orders-heading {
  display: flex;
  min-height: 48rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 8rpx 0 28rpx;
}

.heading-title {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 16rpx;
}

.heading-mark {
  width: 8rpx;
  height: 32rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  background: #8b4d25;
}

.heading-copy {
  color: #6f3b1a;
  font-family: serif;
  font-size: 28rpx;
  font-weight: 700;
  white-space: nowrap;
}

.heading-hint {
  flex-shrink: 0;
  color: #7a726b;
  font-size: 22rpx;
}

.orders-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.order-card {
  box-sizing: border-box;
  padding: 28rpx;
  border: 2rpx solid rgba(232, 224, 212, 0.7);
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 40rpx -4rpx rgba(35, 31, 29, 0.05);
}

.order-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid rgba(232, 224, 212, 0.5);
}

.order-number {
  min-width: 0;
  overflow: hidden;
  color: #7a726b;
  font-family: monospace;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-status {
  flex-shrink: 0;
  padding: 4rpx 20rpx;
  border: 2rpx solid transparent;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.5;
}

.status-PENDING_CONFIRM {
  border-color: rgba(139, 77, 37, 0.2);
  color: #8b4d25;
  background: #f7efe8;
}

.status-PENDING_CHECKIN {
  border-color: #fde68a;
  color: #92400e;
  background: #fef3c7;
}

.status-CHECKED_IN {
  border-color: rgba(78, 122, 101, 0.25);
  color: #4e7a65;
  background: #ebf2ee;
}

.status-COMPLETED {
  border-color: #e8e0d4;
  color: #7a726b;
  background: #faf7f2;
}

.status-CANCELLED {
  border-color: #fecaca;
  color: #b83b2a;
  background: #fef2f2;
}

.order-card-body {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.order-cover {
  width: 160rpx;
  height: 148rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background: #f3ede2;
}

.cover-empty {
  display: block;
}

.order-copy {
  min-width: 0;
  flex: 1;
}

.order-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.order-room {
  overflow: hidden;
  color: #231f1d;
  font-family: serif;
  font-size: 30rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chevron-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.order-dates {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  color: #7a726b;
  font-size: 24rpx;
  white-space: nowrap;
}

.calendar-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.order-nights {
  margin-left: 8rpx;
  color: #231f1d;
  font-weight: 600;
}

.order-price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8rpx;
  margin-top: 16rpx;
}

.order-price-label {
  color: #7a726b;
  font-size: 22rpx;
}

.order-price {
  color: #b83b2a;
  font-size: 34rpx;
  font-weight: 700;
  white-space: nowrap;
}

.orders-state {
  display: flex;
  min-height: 46vh;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  color: #7a726b;
  font-size: 24rpx;
  text-align: center;
}

.orders-error {
  color: #b83b2a;
}

.retry-button {
  min-height: 64rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e8e0d4;
  border-radius: 20rpx;
  color: #6f3b1a;
  background: #ffffff;
  font-size: 22rpx;
  line-height: 62rpx;
}

.retry-button::after {
  border: 0;
}

.orders-loading-more {
  padding: 18rpx 0 8rpx;
  color: #7a726b;
  font-size: 22rpx;
  text-align: center;
}

.orders-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 72rpx 32rpx;
  border: 2rpx solid rgba(232, 224, 212, 0.7);
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 40rpx -4rpx rgba(35, 31, 29, 0.05);
  text-align: center;
}

.empty-title {
  color: #231f1d;
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 28rpx;
  font-weight: 700;
}

.empty-hint {
  color: #7a726b;
  font-size: 22rpx;
}

