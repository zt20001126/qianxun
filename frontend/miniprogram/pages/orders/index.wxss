.orders-page { min-height: 100vh; padding: 26rpx; box-sizing: border-box; background: #fbf5ef; }
.orders-heading { display: flex; align-items: baseline; justify-content: space-between; margin: 8rpx 3rpx 20rpx; color: #512a18; font-family: serif; font-size: 30rpx; font-weight: 600; }
.orders-heading text:last-child { color: #9b8b7d; font-family: sans-serif; font-size: 18rpx; font-weight: 400; }
.orders-list { display: flex; flex-direction: column; gap: 16rpx; }
.order-card { padding: 21rpx 20rpx; border: 1rpx solid #eee3d8; border-radius: 15rpx; background: #fffcf9; box-shadow: 0 8rpx 23rpx rgba(78, 54, 34, .04); }
.order-card-top, .order-card-bottom { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.order-number { overflow: hidden; color: #766454; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.order-status { flex-shrink: 0; padding: 6rpx 12rpx; border-radius: 999rpx; color: #8c643e; background: #f6eadb; font-size: 17rpx; }
.order-room { display: block; margin-top: 18rpx; color: #512a18; font-family: serif; font-size: 24rpx; font-weight: 600; }
.order-dates { display: flex; gap: 12rpx; margin-top: 10rpx; color: #897969; font-size: 19rpx; }
.order-card-bottom { margin-top: 17rpx; padding-top: 13rpx; border-top: 1rpx solid #f0e8df; color: #d74332; font-size: 20rpx; }
.order-link { color: #98501f; font-size: 18rpx; }
.orders-state { display: flex; min-height: 46vh; flex-direction: column; align-items: center; justify-content: center; gap: 15rpx; border: 1rpx solid #eee3d8; border-radius: 15rpx; color: #958679; background: #fffcf9; font-size: 21rpx; }
.orders-error { color: #a94438; }
.empty-seal { display: grid; width: 68rpx; height: 68rpx; place-items: center; border: 1rpx solid #e5d1bd; border-radius: 50%; color: #b18b68; font-family: serif; font-size: 30rpx; }
.retry-button { min-height: 64rpx; padding: 0 22rpx; border: 1rpx solid #d9c8b7; border-radius: 9rpx; color: #795b43; background: #fffdfa; font-size: 20rpx; line-height: 62rpx; }
.retry-button::after { border: 0; }
