<view class="orders-page">
  <view class="orders-heading">
    <view class="heading-title">
      <view class="heading-mark"></view>
      <text class="heading-copy">全部订单（{{total}}）</text>
    </view>
    <text class="heading-hint">点击订单查看详情与退改</text>
  </view>

  <view wx:if="{{loading}}" class="orders-state">正在读取订单…</view>
  <view wx:elif="{{errorMessage}}" class="orders-state orders-error">
    <text>{{errorMessage}}</text>
    <button class="retry-button" bindtap="loadOrders">重新加载</button>
  </view>
  <view wx:elif="{{orders.length === 0}}" class="orders-empty"></view>
  <view wx:else class="orders-list">
    <view wx:for="{{orders}}" wx:key="id" class="order-card" data-order-id="{{item.id}}" bindtap="onOrderTap">
      <view class="order-card-top">
        <text class="order-number">订单号：{{item.order_no}}</text>
        <text class="order-status status-{{item.status}}">{{item.status_label}}</text>
      </view>

      <view class="order-card-body">
        <image wx:if="{{item.cover_image}}" class="order-cover" src="{{item.cover_image}}" mode="aspectFill" />
        <view wx:else class="order-cover cover-empty"></view>
        <view class="order-copy">
          <view class="order-title-row">
            <text class="order-room">{{item.room_name}}</text>
            <image class="chevron-icon" src="/assets/orders-chevron-right.svg" mode="aspectFit" />
          </view>
          <view class="order-dates">
            <image class="calendar-icon" src="/assets/orders-calendar.svg" mode="aspectFit" />
            <text>{{item.check_in_label}} 至 {{item.check_out_label}}</text>
            <text class="order-nights">共{{item.nights}}晚</text>
          </view>
          <view class="order-price-row">
            <text class="order-price-label">实付金额</text>
            <text class="order-price">¥{{item.paid_amount_display}}</text>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{loadingMore}}" class="orders-loading-more">正在读取更多订单…</view>
  </view>
</view>
