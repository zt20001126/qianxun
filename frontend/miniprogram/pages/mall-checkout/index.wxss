.checkout-page{min-height:100vh;box-sizing:border-box;padding:32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));background:#faf7f2;color:#292522}.card{margin-bottom:28rpx;padding:32rpx;border:1rpx solid rgba(232,224,212,.7);border-radius:32rpx;background:#fff;box-shadow:0 8rpx 40rpx rgba(35,31,29,.05)}.product{display:flex;gap:24rpx;padding:28rpx}.cover{width:176rpx;height:176rpx;flex:none;border-radius:20rpx}.product-copy{display:flex;min-width:0;flex:1;flex-direction:column;gap:12rpx}.title{color:#512a18;font-size:30rpx;font-weight:700}.description{display:-webkit-box;overflow:hidden;color:#7a726b;font-size:24rpx;line-height:1.5;-webkit-box-orient:vertical;-webkit-line-clamp:2}.price{margin-top:auto;color:#d74332;font-size:32rpx;font-weight:600}.section-heading{display:flex;align-items:center;gap:14rpx;color:#512a18;font-size:30rpx;font-weight:700}.section-rail{width:6rpx;height:30rpx;border-radius:999rpx;background:#98501f}.form-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;min-height:92rpx;border-bottom:1rpx solid #f0e7df;color:#292522;font-size:26rpx}.form-row input{flex:1;text-align:right;color:#292522}.form-row.no-border{border-bottom:0}.required{color:#d74332}.counter{display:flex;align-items:center;gap:24rpx}.counter button{display:flex;width:60rpx;height:60rpx;align-items:center;justify-content:center;margin:0;padding:0;border-radius:50%;background:#f5e5d6;color:#98501f;font-size:30rpx;line-height:1}.counter button::after{border:0}.fee-title-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.tier-pill{padding:8rpx 14rpx;border-radius:999rpx;color:#8b4d25;background:#f5e5d6;font-size:20rpx}.fee-line{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:12rpx;margin-top:28rpx;color:#292522;font-size:26rpx}.fee-equation{overflow:hidden;color:#7a726b;font-size:23rpx;text-align:right;text-overflow:ellipsis;white-space:nowrap}.fee-value{color:#231f1d;font-weight:600}.points-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:28rpx;padding:26rpx 0;border-top:1rpx solid #f0e7df}.points-description{display:flex;flex-direction:column;gap:10rpx}.points-title{color:#292522;font-size:26rpx}.points-available{color:#7a726b;font-size:22rpx}.points-controls{display:flex;align-items:center;justify-content:flex-end;gap:12rpx}.points-used,.no-points{color:#7a726b;font-size:22rpx}.discount-amount{color:#d74332;font-size:24rpx;font-weight:600}.points-toggle{display:flex;width:76rpx;height:44rpx;align-items:center;padding:4rpx;box-sizing:border-box;border-radius:999rpx;background:#d8cfc6;transition:background .2s}.toggle-thumb{width:36rpx;height:36rpx;border-radius:50%;background:#fff;box-shadow:0 2rpx 6rpx rgba(35,31,29,.2);transition:transform .2s}.points-toggle.is-on{background:#98501f}.points-toggle.is-on .toggle-thumb{transform:translateX(32rpx)}.points-toggle.is-disabled{opacity:.45}.pay-total{display:flex;align-items:baseline;justify-content:space-between;padding-top:24rpx;border-top:1rpx solid #f0e7df;color:#292522;font-size:28rpx;font-weight:600}.pay-total text:last-child{color:#d74332;font-size:38rpx}.fee-loading,.state{padding:30rpx;text-align:center;color:#7a726b}.error{margin-top:20rpx;color:#c23a2d;font-size:24rpx}.hint{margin-top:20rpx;color:#7a726b;font-size:24rpx}.submit{margin:0;border-radius:999rpx;color:#fff;background:#98501f;font-size:30rpx}.submit::after,.check-payment::after{border:0}.submit[disabled]{background:#d7c3b4;color:#fff}.check-payment{margin-top:20rpx;border:2rpx solid rgba(139,77,37,.4);border-radius:999rpx;color:#98501f;background:#fff;font-size:26rpx}.cover-image{width:100%;height:100%}
