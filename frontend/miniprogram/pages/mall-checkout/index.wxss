.checkout-page{min-height:100vh;box-sizing:border-box;padding:32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));background:#fbf5ef;color:#292522}.card{margin-bottom:24rpx;padding:28rpx;border-radius:24rpx;background:#fffcf9;box-shadow:0 8rpx 32rpx rgba(81,42,24,.05)}.product{display:flex;gap:24rpx}.cover{width:160rpx;height:160rpx;flex:none;border-radius:16rpx}.product-copy{display:flex;min-width:0;flex-direction:column;gap:12rpx}.title,.heading{color:#512a18;font-size:30rpx;font-weight:700}.description{overflow:hidden;color:#7a726b;font-size:24rpx;text-overflow:ellipsis;white-space:nowrap}.price,.total text{color:#d74332;font-size:32rpx;font-weight:600}.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;min-height:86rpx;border-bottom:1rpx solid #f0e7df;font-size:26rpx}.row input{flex:1;text-align:right}.counter{display:flex;align-items:center;gap:24rpx}.counter button{width:60rpx;padding:0;background:#f5e5d6;color:#98501f;font-size:30rpx;line-height:60rpx}.summary{display:flex;flex-direction:column;gap:12rpx;padding-top:24rpx;color:#7a726b;font-size:24rpx}.total{text-align:right;color:#292522}.state{padding:30rpx;text-align:center;color:#7a726b}.error{margin-top:20rpx;color:#c23a2d;font-size:24rpx}.hint{margin-top:20rpx;color:#7a726b;font-size:24rpx}.submit{margin:0;background:#98501f;color:#fff;font-size:30rpx;border-radius:24rpx}.submit[disabled]{background:#d7c3b4;color:#fff}
.check-payment{margin-top:20rpx;background:#fffcf9;color:#98501f;font-size:26rpx;border-radius:24rpx}
.cover-image{width:100%;height:100%}.description{overflow:visible;white-space:pre-wrap;word-break:break-all}
