<view class="member-page">
  <view wx:if="{{loading && !member}}" class="page-state">正在读取会员资料…</view>
  <view wx:elif="{{errorMessage && !member}}" class="page-state page-state-error">
    <text>{{errorMessage}}</text><button class="retry-button" bindtap="loadCenter">重新加载</button>
  </view>

  <block wx:if="{{member}}">
    <view class="member-card">
      <view class="member-profile">
        <image class="member-avatar" src="{{member.avatar || avatarSource}}" mode="aspectFill" />
        <view class="profile-copy">
          <text class="member-name">{{member.nickname}}</text>
          <text class="member-phone">{{member.phone}}</text>
        </view>
        <text class="level-badge">{{member.level}}会员</text>
      </view>
      <view class="points-summary">
        <view><text class="summary-number">{{member.points}}</text><text class="summary-label">可用积分</text></view>
        <view><text class="summary-number">{{member.growth_points}}</text><text class="summary-label">成长积分</text></view>
      </view>
      <view class="progress-copy">
        <text wx:if="{{member.next_level_points > 0}}">距离下一等级还差 {{member.next_level_points}} 成长积分</text>
        <text wx:else>已达到最高等级</text>
        <text>{{member.progress_percent}}%</text>
      </view>
      <view class="progress-track"><view class="progress-fill" style="width: {{progressWidth}};"></view></view>
    </view>

    <view class="section-card">
      <view class="section-heading"><text>等级与兑换</text><text class="section-note">积分抵扣房费</text></view>
      <view class="level-row level-heading"><text>等级</text><text>成长积分</text><text>兑换 ¥1</text></view>
      <view wx:for="{{levels}}" wx:key="name" class="level-row {{item.name === member.level ? 'current-level' : ''}}">
        <text>{{item.name}}</text><text>{{item.growth_points}} 起</text><text>{{item.points_per_yuan}} 积分</text>
      </view>
      <view class="rule-note">
        <text>每笔订单最多抵扣房费的 20%</text>
        <text>订单取消成功后返还已抵扣积分</text>
        <text>积分无有效期；订单完成后按实付金额每满 ¥1 奖励 1 积分</text>
      </view>
    </view>

    <view class="section-card">
      <view class="section-heading">
        <text>我的消费订单</text>
        <button class="text-link" bindtap="onOrdersTap">全部订单 ›</button>
      </view>
      <view wx:if="{{recentOrders.length === 0}}" class="empty-copy">暂时还没有会员消费订单</view>
      <view wx:for="{{recentOrders}}" wx:key="id" class="recent-order" data-order-id="{{item.id}}" bindtap="onOrderTap">
        <view><text class="order-room">{{item.room_number}} 房 · {{item.order_no}}</text><text class="order-dates">{{item.check_in}} 至 {{item.check_out}}</text></view>
        <view class="order-price"><text>¥{{item.paid_amount}}</text><text>{{item.status_label}}</text></view>
      </view>
    </view>

    <view class="member-actions">
      <button class="action-row" bindtap="onPointsLogsTap"><text>积分流水</text><text>查看获取、抵扣与返还记录 ›</text></button>
      <button class="action-row" bindtap="onBusinessPhoneTap"><text>商家电话</text><text>{{storePhone}} ›</text></button>
      <button class="action-row logout-row" bindtap="onLogoutTap"><text>退出登录</text><text>›</text></button>
    </view>
  </block>
</view>
