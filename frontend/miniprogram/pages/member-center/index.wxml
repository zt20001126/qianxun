<view class="member-page">
  <image class="member-scene" src="/assets/profile/header-bg.jpg" mode="aspectFill" />
  <view class="member-scene-fade" />
  <image class="member-bottom-art" src="/assets/login-card-river.svg" mode="scaleToFill" />
  <view class="member-navigation" style="padding-top: {{statusBarHeight}}px; height: {{navigationHeight}}px;">会员中心</view>
  <view wx:if="{{loading && !member}}" class="page-state">正在读取会员资料…</view>
  <view wx:elif="{{errorMessage && !member}}" class="page-state page-state-error">
    <text>{{errorMessage}}</text>
    <button class="retry-button" bindtap="loadCenter">重新加载</button>
  </view>

  <block wx:if="{{member && rules}}">
    <view class="member-content">
      <view class="member-card">
        <image class="member-watermark" src="/assets/member-crown-watermark.svg" mode="aspectFit" />

        <view class="member-header">
          <view class="member-emblem">
            <image class="member-emblem-icon" src="/assets/member-crown-gold.svg" mode="aspectFit" />
          </view>
          <view class="member-heading-copy">
            <view class="member-title-row">
              <text class="member-tier-name">{{currentTierName}}</text>
              <text class="member-current-badge">当前等级</text>
            </view>
            <text class="member-benefit">{{currentRate}}积分抵¥1 · 永久保级</text>
          </view>
        </view>

        <view class="progress-panel">
          <view class="progress-copy">
            <text class="upgrade-title">{{upgradeTitle}}</text>
            <text class="upgrade-hint">{{upgradeHint}}</text>
          </view>
          <view class="progress-track">
            <view class="progress-fill" style="width: {{progressWidth}};"></view>
          </view>
        </view>
      </view>

      <view class="points-summary-card">
        <view class="points-grid">
          <view class="points-item growth-item">
            <view class="points-icon growth-icon">
              <image src="/assets/member-coins.svg" mode="aspectFit" />
            </view>
            <view class="points-copy">
              <text class="points-label">成长积分</text>
              <text class="points-number growth-number">{{growthPointsDisplay}}</text>
            </view>
          </view>

          <view class="points-item available-item">
            <view class="points-icon available-icon">
              <image src="/assets/member-wallet.svg" mode="aspectFit" />
            </view>
            <view class="points-copy">
              <text class="points-label">可用积分</text>
              <text class="points-number available-number">{{availablePointsDisplay}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="feature-card">
        <view class="feature-row" bindtap="onPointsLogsTap">
          <view class="feature-main">
            <view class="feature-icon-box">
              <image src="/assets/member-coins.svg" mode="aspectFit" />
            </view>
            <text class="feature-title">积分明细</text>
          </view>
          <view class="feature-extra">
            <image src="/assets/member-chevron-right.svg" mode="aspectFit" />
          </view>
        </view>

        <view class="feature-row" bindtap="onPointsRuleTap">
          <view class="feature-main">
            <view class="feature-icon-box">
              <image src="/assets/member-book-open.svg" mode="aspectFit" />
            </view>
            <text class="feature-title">积分规则</text>
          </view>
          <view class="feature-extra">
            <image src="/assets/member-chevron-right.svg" mode="aspectFit" />
          </view>
        </view>
      </view>

      <view class="tier-card">
        <view class="tier-heading">
          <view class="tier-heading-main">
            <view class="tier-heading-mark"></view>
            <text class="tier-heading-title">会员权益</text>
          </view>
          <text class="tier-heading-note">最高抵扣{{maxDiscountRateLabel}}房费</text>
        </view>

        <view class="tier-grid">
          <view wx:for="{{tierRows}}" wx:key="min_points" class="tier-item tier-{{index}} {{item.is_current ? 'tier-current' : ''}}">
            <image class="tier-crown" src="{{item.is_current ? '/assets/member-crown-gold.svg' : '/assets/member-crown-wood.svg'}}" mode="aspectFit" />
            <text class="tier-name">{{item.matrix_name}}</text>
            <text class="tier-threshold">{{item.range_label}}</text>
            <view class="tier-rate"><text>{{item.points_per_yuan}}积分抵¥1</text></view>
          </view>
        </view>


      </view>
    </view>
  </block>

  <view wx:if="{{showPointsRuleModal}}" class="points-modal-overlay">
    <view class="points-modal">
      <view class="modal-heading"><text class="points-modal-title">会员与积分规则</text><view class="modal-x" bindtap="onPointsRuleClose">×</view></view>

      <view class="points-modal-table">
        <view class="points-modal-table-header">
          <text>会员等级</text>
          <text>成长积分</text>
          <text>抵扣比例</text>
        </view>
        <view wx:for="{{tierRows}}" wx:key="min_points" class="points-modal-table-row">
          <view class="modal-tier-name"><image class="modal-tier-icon" src="/assets/member-crown-wood.svg" mode="aspectFit" /><text>{{item.member_name}}</text></view>
          <text class="modal-tier-range">{{item.modal_range_label}}</text>
          <text class="modal-tier-rate">{{item.points_per_yuan}}积分抵¥1</text>
        </view>
      </view>

      <view class="points-modal-rules">
        <view class="points-modal-rule"><image src="/assets/member-coins.svg" /><view><text class="points-modal-rule-title">积分获取</text><text>订单完成后，实付每满¥1得1积分（向下取整）。历史补发计入成长积分，赠送仅增加可用积分。</text></view></view>
        <view class="points-modal-rule"><image src="/assets/icons/ticket.svg" /><view><text class="points-modal-rule-title">积分抵扣</text><text>单笔最高抵扣房费的 <text class="points-modal-discount">{{maxDiscountRateLabel}}</text>。</text></view></view>
        <view class="points-modal-rule"><image src="/assets/orders-rotate-ccw.svg" /><view><text class="points-modal-rule-title">积分返还</text><text>自助取消退款成功后，抵扣积分全额退回。</text></view></view>
        <view class="points-modal-rule"><image src="/assets/icons/award-celadon.svg" /><view><text class="points-modal-rule-title">永久有效</text><text>积分永久有效，消费积分不影响会员等级。</text></view></view>
      </view>
      <button class="points-modal-close" bindtap="onPointsRuleClose">我知道了</button>
    </view>
  </view>
</view>
