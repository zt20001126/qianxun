.member-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 16rpx 32rpx 64rpx;
  color: #231f1d;
  background: #faf7f2;
}

.member-content {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.page-state {
  display: grid;
  min-height: 240rpx;
  align-content: center;
  justify-items: center;
  gap: 20rpx;
  color: #7a726b;
  font-size: 26rpx;
}

.page-state-error {
  color: #b83b2a;
}

.retry-button {
  min-height: 68rpx;
  padding: 0 28rpx;
  border-radius: 12rpx;
  color: #ffffff;
  background: #8b4d25;
  font-size: 24rpx;
}

.retry-button::after,
.points-modal-close::after {
  border: 0;
}

/* 会员卡：深茶棕卡面叠加水乡建筑暗纹，标题、等级与升级进度分三层排列。 */
.member-card {
  position: relative;
  display: flex;
  min-height: 348rpx;
  overflow: hidden;
  box-sizing: border-box;
  flex-direction: column;
  padding: 34rpx 42rpx 36rpx;
  border: 2rpx solid #a7805d;
  border-radius: 32rpx;
  color: #ffffff;
  background: #4a2d1d;
  box-shadow: 0 20rpx 50rpx rgba(52, 36, 24, 0.26);
}

.card-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.card-heading {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #efcf9a;
  line-height: 1.1;
}

.card-brand {
  font-family: "Songti SC", serif;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.card-label {
  padding-bottom: 6rpx;
  border-bottom: 1rpx solid rgba(200, 157, 103, 0.55);
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

.member-header {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 30rpx;
}

.member-emblem {
  display: flex;
  width: 84rpx;
  height: 84rpx;
  flex: 0 0 84rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(224, 186, 130, 0.64);
  border-radius: 50%;
  background: rgba(251, 230, 197, 0.08);
}

.member-emblem-icon {
  width: 46rpx;
  height: 46rpx;
}

.member-heading-copy {
  min-width: 0;
  flex: 1;
}

.member-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.member-tier-name {
  color: #fffaf1;
  font-family: "Songti SC", serif;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
  white-space: nowrap;
}

.member-benefit {
  display: block;
  margin-top: 4rpx;
  color: #e5c8a7;
  font-size: 24rpx;
  line-height: 1.45;
}

.progress-panel {
  position: relative;
  z-index: 1;
  margin-top: auto;
  padding: 24rpx 0 0;
  border-radius: 0;
  color: #ffffff;
  background: transparent;
}

.progress-copy {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.upgrade-title {
  color: #fff3df;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}

.upgrade-hint {
  color: #e5c8a7;
  font-size: 22rpx;
  text-align: right;
}

.progress-track {
  height: 4rpx;
  overflow: hidden;
  border-radius: 9999rpx;
  background: rgba(251, 230, 197, 0.22);
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #f2d6a2 0%, #bc8b54 100%);
}

.points-summary-card,
.feature-card,
.tier-card {
  border: 2rpx solid rgba(232, 224, 212, 0.7);
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 40rpx -4rpx rgba(35, 31, 29, 0.05);
}

.points-summary-card {
  padding: 32rpx;
}

.points-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: center;
}

.points-item {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 24rpx;
}

.growth-item {
  padding-right: 24rpx;
}

.available-item {
  padding-left: 28rpx;
  border-left: 2rpx solid rgba(232, 224, 212, 0.7);
}

.points-icon {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  flex: 0 0 80rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.growth-icon {
  background: #f7efe8;
}

.available-icon {
  background: rgba(184, 59, 42, 0.1);
}

.points-icon image {
  width: 40rpx;
  height: 40rpx;
}

.points-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.points-label {
  color: #7a726b;
  font-size: 22rpx;
  white-space: nowrap;
}

.points-number {
  margin-top: 4rpx;
  font-family: serif;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
}

.growth-number {
  color: #231f1d;
}

.available-number {
  color: #b83b2a;
}

.feature-extra image {
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
}

.feature-card {
  overflow: hidden;
}

.feature-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 32rpx;
}

.feature-row + .feature-row {
  border-top: 2rpx solid rgba(232, 224, 212, 0.6);
}

.feature-main,
.feature-extra {
  display: flex;
  align-items: center;
}

.feature-main {
  min-width: 0;
  gap: 24rpx;
}

.feature-icon-box {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #f7efe8;
}

.feature-icon-box image {
  width: 32rpx;
  height: 32rpx;
}

.feature-title {
  color: #231f1d;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}

.feature-extra {
  flex: 0 0 auto;
  gap: 8rpx;
  color: #7a726b;
  font-size: 22rpx;
  white-space: nowrap;
}

.tier-card {
  padding: 32rpx;
}

.tier-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.tier-heading-main {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 16rpx;
}

.tier-heading-mark {
  width: 8rpx;
  height: 32rpx;
  flex: 0 0 8rpx;
  border-radius: 9999rpx;
  background: #8b4d25;
}

.tier-heading-title {
  color: #6f3b1a;
  font-family: serif;
  font-size: 28rpx;
  font-weight: 700;
  white-space: nowrap;
}

.tier-heading-note {
  flex: 0 0 auto;
  color: #7a726b;
  font-size: 20rpx;
  white-space: nowrap;
}

.tier-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16rpx;
  text-align: center;
}

.tier-item {
  display: flex;
  min-width: 0;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
  border: 2rpx solid rgba(232, 224, 212, 0.7);
  border-radius: 24rpx;
  color: #231f1d;
  background: #faf7f2;
}

.tier-current {
  border-color: #8b4d25;
  color: #ffffff;
  background: #8b4d25;
}

.tier-crown {
  width: 32rpx;
  height: 32rpx;
  margin-bottom: 8rpx;
}

.tier-name {
  color: inherit;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.tier-threshold {
  margin-top: 4rpx;
  color: #7a726b;
  font-size: 20rpx;
  white-space: nowrap;
}

.tier-current .tier-threshold {
  color: rgba(255, 255, 255, 0.85);
}

.tier-rate {
  width: 100%;
  box-sizing: border-box;
  margin-top: 12rpx;
  padding-top: 8rpx;
  border-top: 2rpx solid #e8e0d4;
  color: #8b4d25;
  font-size: 20rpx;
  font-weight: 600;
  white-space: nowrap;
}

.tier-current .tier-rate {
  border-top-color: rgba(255, 255, 255, 0.2);
  color: #fbe6c5;
}

.tier-footnote {
  display: block;
  margin-top: 20rpx;
  color: #7a726b;
  font-size: 20rpx;
  line-height: 1.6;
}

.points-modal-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4rpx);
}

.points-modal {
  box-sizing: border-box;
  width: 100%;
  max-width: 650rpx;
  padding: 48rpx;
  border: 2rpx solid #e8e0d4;
  border-radius: 48rpx;
  background: #ffffff;
  box-shadow: 0 50rpx 100rpx -24rpx rgba(0, 0, 0, 0.25);
}

.points-modal-title {
  display: block;
  color: #231f1d;
  font-family: serif;
  font-size: 32rpx;
  font-weight: 700;
}

.points-modal-table {
  overflow: hidden;
  margin-top: 24rpx;
  border: 2rpx solid #e8e0d4;
  border-radius: 24rpx;
  font-size: 22rpx;
}

.points-modal-table-header,
.points-modal-table-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: center;
  text-align: center;
}

.points-modal-table-header {
  padding: 16rpx 8rpx;
  color: #8b4d25;
  background: #f7efe8;
  font-weight: 700;
}

.points-modal-table-row {
  padding: 16rpx 8rpx;
  border-top: 2rpx solid rgba(232, 224, 212, 0.6);
}

.modal-tier-name {
  color: #231f1d;
  font-weight: 500;
}

.modal-tier-range {
  color: #7a726b;
}

.modal-tier-rate {
  color: #8b4d25;
  font-weight: 600;
}

.points-modal-rules {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 28rpx;
  color: #7a726b;
  font-size: 22rpx;
  line-height: 1.6;
}

.points-modal-rule {
  display: flex;
  align-items: flex-start;
}

.points-modal-bullet {
  flex: 0 0 auto;
}

.points-modal-rule-title {
  color: #231f1d;
  font-weight: 700;
}

.points-modal-discount {
  color: #b83b2a;
  font-weight: 600;
}

.points-modal-close {
  width: 100%;
  margin: 40rpx 0 0;
  padding: 20rpx 0;
  border: 0;
  border-radius: 24rpx;
  color: #ffffff;
  background: #8b4d25;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.5;
}

/* 水乡背景只装饰当前页面，会员资料仍由接口提供。 */
.member-page { position:relative; overflow:hidden; padding:0 0 64rpx; }
.member-scene,.member-scene-fade { position:absolute; top:0; left:0; width:100%; height:460rpx; }
.member-scene-fade { background:linear-gradient(to bottom,transparent 35%,#faf7f2 100%); pointer-events:none; }
.member-bottom-art { position:absolute; bottom:0; width:100%; height:180rpx; opacity:.45; pointer-events:none; }
.member-navigation { position:relative; z-index:1; display:flex; align-items:center; justify-content:center; box-sizing:content-box; font-size:32rpx; font-weight:600; }
.member-content { position:relative; z-index:1; padding:120rpx 32rpx 20rpx; gap:22rpx; }
.member-title-row { flex-wrap:wrap; gap:8rpx; }
.points-summary-card { padding:24rpx 32rpx; }
.points-icon,.feature-icon-box { border-radius:50%; background:#faead9; }
.feature-row { padding:18rpx 32rpx; }
.tier-card { padding:24rpx 18rpx; }
.tier-grid { gap:10rpx; }
.tier-item { padding:16rpx 2rpx; }
.tier-rate { font-size:18rpx; letter-spacing:-1rpx; }
.points-modal-overlay { padding:24rpx; backdrop-filter:none; }
.points-modal { max-height:calc(100vh - 80rpx); overflow-y:auto; padding:32rpx 36rpx; background:#fffbf6; }
.modal-heading { display:flex; align-items:center; justify-content:space-between; }
.points-modal-title { color:#8b4d25; }
.modal-x { padding:0 8rpx; color:#8b4d25; font-size:44rpx; line-height:1; }
.points-modal-rules { gap:0; }
.points-modal-rule { align-items:center; gap:20rpx; padding:14rpx 0; border-bottom:1rpx solid #eee1d5; }
.points-modal-rule image { width:44rpx; height:44rpx; flex:none; padding:14rpx; border-radius:50%; background:#f8eadb; }
.points-modal-rule view { display:flex; min-width:0; flex-direction:column; }
.points-modal-rule-title { font-size:25rpx; }
.points-modal-close { border-radius:999rpx; margin-top:24rpx; }

.tier-0:not(.tier-current),.tier-2:not(.tier-current) { background:#f8ecdf; }
.tier-1:not(.tier-current) { background:#f0ebe6; }
.modal-tier-name { display:flex; justify-content:center; align-items:center; gap:5rpx; white-space:nowrap; }
.modal-tier-icon { width:24rpx; height:24rpx; flex:none; }
