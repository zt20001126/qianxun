.member-page { min-height: 100vh; padding: 28rpx 28rpx 48rpx; color: #292522; background: #fbf5ef; }
.page-state { display: grid; min-height: 240rpx; align-content: center; justify-items: center; gap: 20rpx; color: #8b7d70; font-size: 26rpx; }
.page-state-error { color: #a1483b; }
.retry-button { min-height: 68rpx; padding: 0 28rpx; border-radius: 12rpx; color: #fffaf5; background: #98501f; font-size: 24rpx; }
.member-card, .section-card { margin-bottom: 24rpx; padding: 28rpx; border: 1rpx solid #eee4da; border-radius: 20rpx; background: #fffcf9; box-shadow: 0 8rpx 24rpx rgba(87, 60, 39, .04); }
.member-card { color: #fffaf4; background: linear-gradient(135deg, #754120, #98501f 62%, #b57642); }
.member-profile { display: flex; align-items: center; gap: 18rpx; }
.member-avatar { width: 84rpx; height: 84rpx; border: 3rpx solid rgba(255, 250, 244, .7); border-radius: 50%; background: #f5e5d6; }
.profile-copy { display: grid; flex: 1; gap: 8rpx; }
.member-name { font-size: 31rpx; font-weight: 600; }
.member-phone { color: rgba(255, 250, 244, .8); font-size: 23rpx; }
.level-badge { padding: 9rpx 17rpx; border: 1rpx solid rgba(255, 244, 220, .45); border-radius: 999rpx; color: #fff0cf; font-size: 22rpx; }
.points-summary { display: flex; gap: 100rpx; margin-top: 36rpx; }
.points-summary view { display: grid; gap: 6rpx; }
.summary-number { font-family: Georgia, serif; font-size: 43rpx; }
.summary-label { color: rgba(255, 250, 244, .78); font-size: 21rpx; }
.progress-copy { display: flex; justify-content: space-between; margin-top: 28rpx; color: rgba(255, 250, 244, .88); font-size: 21rpx; }
.progress-track { height: 10rpx; margin-top: 12rpx; overflow: hidden; border-radius: 99rpx; background: rgba(255, 252, 249, .28); }
.progress-fill { height: 100%; border-radius: inherit; background: #f1d6a4; }
.section-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; color: #512a18; font-size: 29rpx; font-weight: 600; }
.section-note { color: #9a8b7c; font-size: 21rpx; font-weight: 400; }
.level-row { display: grid; grid-template-columns: 1fr 1fr 1fr; padding: 17rpx 4rpx; border-bottom: 1rpx solid #f1eae2; color: #62574c; font-size: 23rpx; }
.level-row text:nth-child(2), .level-row text:nth-child(3) { text-align: right; }
.level-heading { color: #a09182; font-size: 20rpx; }
.current-level { color: #98501f; font-weight: 600; }
.rule-note { display: grid; gap: 12rpx; margin-top: 20rpx; color: #82766b; font-size: 21rpx; line-height: 1.5; }
.rule-note text::before { content: '·'; margin-right: 10rpx; color: #98501f; }
.text-link { padding: 0; border: 0; color: #98501f; background: transparent; font-size: 22rpx; }
.recent-order { display: flex; justify-content: space-between; gap: 14rpx; padding: 20rpx 0; border-top: 1rpx solid #f1eae2; }
.recent-order view:first-child { display: grid; min-width: 0; gap: 8rpx; }
.order-room { overflow: hidden; color: #4d4035; font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.order-dates, .order-price text:last-child { color: #988b7e; font-size: 20rpx; }
.order-price { display: grid; flex: 0 0 auto; justify-items: end; gap: 8rpx; }
.order-price text:first-child { color: #d74332; font-family: Georgia, serif; font-size: 23rpx; }
.empty-copy { padding: 22rpx 0; color: #9b8e82; font-size: 22rpx; text-align: center; }
.member-actions { overflow: hidden; border: 1rpx solid #eee4da; border-radius: 18rpx; background: #fffcf9; }
.action-row { display: flex; width: 100%; min-height: 90rpx; align-items: center; justify-content: space-between; padding: 0 26rpx; border-bottom: 1rpx solid #f1eae2; border-radius: 0; color: #4d4035; background: transparent; font-size: 24rpx; text-align: left; }
.action-row::after { border: 0; }
.action-row text:last-child { color: #94877a; font-size: 21rpx; }
.logout-row { border-bottom: 0; color: #a1483b; }
