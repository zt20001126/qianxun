<view class="success-page">
  <view wx:if="{{loading}}" class="success-loading">{{loadingText}}</view>
  <view wx:elif="{{errorMessage}}" class="success-content success-content-error">
    <view class="success-card">
      <text class="success-copy">{{errorMessage}}</text>
      <view class="success-actions">
        <button class="order-button" bindtap="onRetryTap">重新查询支付状态</button>
        <button class="home-button" bindtap="onHomeTap">返回首页</button>
      </view>
    </view>
  </view>
  <view wx:elif="{{confirmed}}">
    <view class="success-hero">
      <image class="success-hero-image" src="../../assets/login-baijianlou-hero.jpg" mode="aspectFill" />
      <view class="success-hero-shade"></view>
    </view>

    <view class="success-content">
      <view class="success-card">
        <view class="success-seal">
          <view class="success-seal-inner"><qx-icon name="check-white" size="68" /></view>
        </view>
        <text class="success-title">{{successTitle}}</text>
        <view class="success-copy">
          <text class="success-copy-line">{{successCopyFirst}}</text>
          <text class="success-copy-line">{{successCopySecond}}</text>
        </view>
        <view class="success-order-pill" bindtap="onCopyTap">
          <text>订单号：<text class="order-no">{{orderNo}}</text></text>
          <qx-icon name="copy" size="28" />
        </view>
      </view>

      <view class="success-actions">
        <button class="order-button" bindtap="onDetailTap">
          <qx-icon name="clipboard-list" size="32" /><text>查看订单</text>
        </button>
        <button class="home-button" bindtap="onHomeTap">
          <qx-icon name="home" size="32" /><text>返回首页</text>
        </button>
      </view>
    </view>
  </view>
</view>
