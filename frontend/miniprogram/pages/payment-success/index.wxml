<view class="success-page">
  <view wx:if="{{loading}}" class="success-loading">正在确认预订结果…</view>
  <view wx:elif="{{confirmed}}">
    <view class="success-hero">
      <image class="success-hero-image" src="../../assets/login-baijianlou-hero.webp" mode="aspectFill" />
      <view class="success-hero-shade"></view>
    </view>

    <view class="success-content">
      <view class="success-card">
        <view class="success-seal">
          <view class="success-seal-inner"><qx-icon name="check-white" size="68" /></view>
        </view>
        <text class="success-title">预订成功</text>
        <text class="success-copy">您的房间已预订，<br />可在「我的订单」中查看。</text>
        <view class="success-order-pill" bindtap="onCopyTap">
          <text>订单号：<text class="order-no">{{orderNo}}</text></text>
          <qx-icon name="copy" size="28" />
        </view>
      </view>

      <view class="success-actions">
        <button class="order-button" bindtap="onDetailTap">
          <qx-icon name="clipboard-list" size="32" /><text>查看订单</text>
        </button>
        <button class="home-button" bindtap="onHomeTap">
          <qx-icon name="home" size="32" /><text>返回首页</text>
        </button>
      </view>
      <view class="home-indicator"></view>
    </view>
  </view>
</view>
