.success-page { display: flex; min-height: 100vh; align-items: flex-start; justify-content: center; padding: 60rpx 28rpx; box-sizing: border-box; background: #fbf5ef; }
.success-card { width: 100%; padding: 38rpx 27rpx; box-sizing: border-box; border: 1rpx solid #eee3d8; border-radius: 18rpx; background: #fffcf9; box-shadow: 0 12rpx 34rpx rgba(78, 54, 34, .06); text-align: center; }
.success-mark { display: grid; width: 82rpx; height: 82rpx; place-items: center; margin: 0 auto; border-radius: 50%; color: #fffaf4; background: #718663; font-size: 43rpx; }
.success-title { display: block; margin-top: 21rpx; color: #512a18; font-family: serif; font-size: 31rpx; font-weight: 600; }
.success-copy { display: block; margin-top: 9rpx; color: #9b8b7d; font-size: 19rpx; }
.success-order { display: flex; min-height: 67rpx; align-items: center; justify-content: space-between; margin-top: 12rpx; padding: 0 13rpx; border-bottom: 1rpx solid #f0e8df; color: #897969; font-size: 19rpx; text-align: left; }
.success-order text:last-child { color: #4e4035; }
.success-price { color: #d74332 !important; font-size: 24rpx; font-weight: 600; }
.primary-button, .secondary-button { width: 100%; height: 76rpx; margin-top: 24rpx; border: 0; border-radius: 10rpx; color: #fffaf4; background: #98501f; font-size: 22rpx; line-height: 76rpx; }
.primary-button::after, .secondary-button::after, .text-button::after { border: 0; }
.secondary-button { margin-top: 13rpx; border: 1rpx solid #decdbc; color: #795b43; background: #fffdfa; }
.text-button { height: 64rpx; margin-top: 9rpx; color: #9a8978; background: transparent; font-size: 20rpx; line-height: 64rpx; }
