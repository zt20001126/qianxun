<view class="page-shell">
  <view class="hero-scene">
    <image class="hero-background" src="../../assets/login-baijianlou-hero.jpg" mode="aspectFill" />
    <view class="hero-wash"></view>

    <view class="brand-block">
      <view class="brand-heading">
        <text class="brand-title">芊浔民宿</text>
        <view class="brand-seal">
          <text>南</text>
          <text>浔</text>
        </view>
      </view>
      <view class="brand-subtitle">
        <view class="subtitle-rule"></view>
        <text>南浔古镇 · 水乡民宿</text>
        <view class="subtitle-rule"></view>
      </view>
    </view>
  </view>

  <view class="login-card">
    <image class="card-crest" src="../../assets/login-card-crest.svg" mode="scaleToFill" />
    <image class="card-house" src="../../assets/login-card-house.svg" mode="aspectFit" />
    <image class="card-bamboo" src="../../assets/login-card-bamboo.svg" mode="aspectFit" />

    <view class="card-content">
      <view class="title-row">
        <view class="title-rule title-rule-left"></view>
        <text class="card-title">登录</text>
        <view class="title-rule title-rule-right"></view>
      </view>

      <text wx:if="{{errorMessage}}" class="error-message">{{errorMessage}}</text>
      <button class="login-button" hover-class="login-button-hover" loading="{{loading}}" disabled="{{loading}}" open-type="getPhoneNumber" bindgetphonenumber="onPhoneAuthorized">
        <image wx:if="{{!loading}}" class="wechat-icon" src="../../assets/login-wechat.svg" mode="aspectFit" />
        <text>{{loading ? '正在登录…' : '微信授权登录'}}</text>
      </button>

      <view class="terms-row">
        <view class="terms-checkbox {{agreedTerms ? 'terms-checkbox-checked' : ''}}" bindtap="onTermsToggle">
          <text wx:if="{{agreedTerms}}" class="terms-check">✓</text>
        </view>
        <view class="terms-copy" bindtap="onTermsToggle">
          <text>我已阅读并同意</text>
          <text class="terms-link" data-type="user" catchtap="onAgreementTap">《用户协议》</text>
          <text>和</text>
          <text class="terms-link" data-type="privacy" catchtap="onAgreementTap">《隐私协议》</text>
        </view>
      </view>
    </view>

    <image class="card-river-art" src="../../assets/login-card-river.svg" mode="scaleToFill" />
  </view>

  <view class="scenery">
    <view class="river-wave river-wave-back"></view>
    <view class="river-wave river-wave-front"></view>
    <view class="footer-boat">
      <view class="boat-sail"></view>
      <view class="boat-hull"></view>
    </view>
  </view>
</view>
