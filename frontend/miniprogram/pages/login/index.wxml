<view class="page-shell">
  <view class="hero-scene">
    <image class="hero-background" src="../../assets/login-baijianlou-hero.webp" mode="aspectFill" />
    <view class="hero-wash"></view>

    <view class="brand-block">
      <view class="brand-heading">
        <text class="brand-title">芊浔民宿</text>
        <view class="brand-seal">
          <text>南</text>
          <text>浔</text>
        </view>
      </view>
      <view class="brand-subtitle">
        <view class="subtitle-rule"></view>
        <text>南浔古镇 · 水乡民宿</text>
        <view class="subtitle-rule"></view>
      </view>
    </view>
  </view>

  <view class="login-card">
    <text class="card-title">手机号登录</text>

    <view class="phone-field">
      <view class="phone-icon"><view class="phone-icon-dot"></view></view>
      <input
        class="phone-input"
        type="number"
        maxlength="11"
        value="{{phone}}"
        placeholder="请输入手机号"
        placeholder-class="placeholder"
        confirm-type="done"
        bindinput="onPhoneInput"
        bindconfirm="onLoginTap"
      />
    </view>

    <text wx:if="{{errorMessage}}" class="error-message">{{errorMessage}}</text>
    <button class="login-button" loading="{{loading}}" disabled="{{loading}}" bindtap="onLoginTap">
      {{loading ? '正在登录…' : '登录'}}
    </button>

    <view class="terms-row" bindtap="onTermsToggle">
      <view class="terms-checkbox {{agreedTerms ? 'terms-checkbox-checked' : ''}}">
        <text wx:if="{{agreedTerms}}" class="terms-check">✓</text>
      </view>
      <view class="terms-copy">
        <text>我已阅读并同意</text>
        <text class="terms-link">《用户协议》</text>
        <text>和</text>
        <text class="terms-link">《隐私协议》</text>
      </view>
    </view>

  </view>

  <view class="scenery">
    <view class="river-wave river-wave-back"></view>
    <view class="river-wave river-wave-front"></view>
    <view class="footer-boat">
      <view class="boat-sail"></view>
      <view class="boat-hull"></view>
    </view>
  </view>
</view>
