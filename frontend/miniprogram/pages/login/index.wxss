.page-shell {
  position: relative;
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
  padding: 72rpx 48rpx 38rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f7eadc 0%, #fbf5ef 42%, #fbf5ef 100%);
}

.plum-branch { position: absolute; top: 18rpx; right: -72rpx; width: 300rpx; opacity: .26; pointer-events: none; }
.brand-block { display: flex; width: 100%; flex-direction: column; align-items: center; margin: 28rpx 0 52rpx; }
.brand-seal { display: grid; width: 88rpx; height: 88rpx; place-items: center; margin-bottom: 22rpx; border: 2rpx solid rgba(152, 80, 31, .62); border-radius: 50%; color: #98501f; font-family: serif; font-size: 44rpx; }
.brand-kicker { color: #9f8063; font-size: 18rpx; letter-spacing: 5rpx; }
.brand-title { margin-top: 12rpx; color: #512a18; font-family: serif; font-size: 56rpx; font-weight: 600; letter-spacing: 10rpx; }
.brand-subtitle { margin-top: 13rpx; color: #8f8173; font-family: serif; font-size: 23rpx; letter-spacing: 4rpx; }

.login-card { z-index: 1; width: 100%; padding: 42rpx 34rpx 34rpx; box-sizing: border-box; border: 1rpx solid rgba(148, 111, 76, .16); border-radius: 20rpx; background: rgba(255, 252, 249, .96); box-shadow: 0 16rpx 48rpx rgba(96, 65, 39, .08); }
.card-title { display: block; color: #512a18; font-family: serif; font-size: 34rpx; font-weight: 600; }
.card-caption { display: block; margin-top: 12rpx; color: #94877a; font-size: 23rpx; }
.phone-field { display: flex; align-items: center; height: 96rpx; margin-top: 38rpx; padding: 0 22rpx; border: 1rpx solid #e7ddd1; border-radius: 12rpx; background: #fffdfa; }
.country-code { padding-right: 20rpx; border-right: 1rpx solid #e8dfd4; color: #6c5e51; font-size: 28rpx; }
.phone-input { flex: 1; height: 100%; padding-left: 20rpx; color: #292522; font-size: 29rpx; }
.placeholder { color: #b5aaa0; }
.error-message { display: block; margin-top: 14rpx; color: #bd493b; font-size: 22rpx; }
.login-button { height: 92rpx; margin-top: 32rpx; border-radius: 12rpx; color: #fffaf5; background: #98501f; font-size: 29rpx; font-weight: 600; letter-spacing: 3rpx; line-height: 92rpx; }
.login-button[disabled] { opacity: .68; }
.phone-notice { display: block; margin-top: 25rpx; color: #a09489; font-size: 20rpx; line-height: 1.7; }
.scenery { display: flex; width: 100%; flex-direction: column; align-items: center; margin-top: auto; padding-top: 48rpx; }
.scenery image { width: 100%; opacity: .72; }
.scenery text { margin-top: 4rpx; color: #aa9988; font-size: 19rpx; letter-spacing: 4rpx; }
