.page-shell {
  position: relative;
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  align-items: stretch;
  padding: 0 48rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: #faf7f2;
}

.hero-scene {
  position: relative;
  flex-shrink: 0;
  width: calc(100% + 96rpx);
  height: 500rpx;
  margin-left: -48rpx;
  overflow: hidden;
}

.hero-background,
.hero-wash {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.hero-background {
  object-fit: cover;
  object-position: center center;
}

.hero-wash {
  background: linear-gradient(180deg, rgba(255, 251, 235, 0.35) 0%, rgba(250, 247, 242, 0.25) 48%, rgba(250, 247, 242, 0.82) 86%, #faf7f2 100%);
}

.brand-block {
  position: absolute;
  z-index: 1;
  top: 72rpx;
  left: 0;
  display: flex;
  width: 100%;
  flex-direction: column;
  align-items: center;
}

.brand-heading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.brand-title {
  color: #6f3b1a;
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 68rpx;
  font-weight: 700;
  letter-spacing: 9rpx;
  text-shadow: 0 2rpx 16rpx rgba(255, 252, 249, 0.75);
}

.brand-seal {
  display: flex;
  width: 42rpx;
  height: 60rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  color: #ffffff;
  background: #b83b2a;
  box-shadow: 0 4rpx 12rpx rgba(184, 59, 42, 0.2);
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.15;
}

.brand-subtitle {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 16rpx;
  color: #8b4d25;
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 5rpx;
}

.subtitle-rule {
  width: 48rpx;
  height: 2rpx;
  background: rgba(139, 77, 37, 0.4);
}

.login-card {
  position: relative;
  z-index: 2;
  width: 100%;
  margin-top: 24rpx;
  padding: 96rpx 38rpx 110rpx;
  box-sizing: border-box;
  border: 2rpx solid #e8d7c7;
  border-radius: 38rpx;
  background: #fffcf8;
  box-shadow: 0 18rpx 54rpx rgba(110, 64, 31, 0.12);
}

.card-content {
  position: relative;
  z-index: 2;
}

.card-crest {
  position: absolute;
  z-index: 1;
  top: -60rpx;
  left: 50%;
  width: 280rpx;
  height: 70rpx;
  transform: translateX(-50%);
  pointer-events: none;
}

.card-house {
  position: absolute;
  z-index: 2;
  top: -43rpx;
  left: 50%;
  width: 62rpx;
  height: 46rpx;
  transform: translateX(-50%);
  pointer-events: none;
}

.card-bamboo {
  position: absolute;
  z-index: 1;
  top: 8rpx;
  right: 0;
  width: 186rpx;
  height: 154rpx;
  opacity: 0.36;
  pointer-events: none;
}

.card-river-art {
  position: absolute;
  z-index: 1;
  right: 0;
  bottom: 2rpx;
  left: 0;
  width: 100%;
  height: 112rpx;
  border-radius: 0 0 36rpx 36rpx;
  pointer-events: none;
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.card-title {
  display: inline-block;
  color: #292421;
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 42rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  line-height: 1.4;
}

.title-rule {
  width: 88rpx;
  height: 2rpx;
  flex-shrink: 0;
}

.title-rule-left {
  background: linear-gradient(90deg, rgba(150, 80, 39, 0.08), rgba(150, 80, 39, 0.66));
}

.title-rule-right {
  background: linear-gradient(90deg, rgba(150, 80, 39, 0.66), rgba(150, 80, 39, 0.08));
}

.error-message {
  display: block;
  margin-top: 14rpx;
  color: #b83b2a;
  font-size: 22rpx;
  line-height: 1.55;
}

.phone-field {
  display: flex;
  height: 92rpx;
  align-items: center;
  margin-top: 54rpx;
  padding: 0 28rpx;
  border: 2rpx solid #ead9c8;
  border-radius: 999rpx;
  box-sizing: border-box;
  background: #fffdfa;
}

.phone-field-icon {
  margin-right: 22rpx;
  color: #8b4d25;
  font-size: 34rpx;
}

.phone-input {
  flex: 1;
  min-width: 0;
  color: #292421;
  font-size: 28rpx;
}

.phone-placeholder {
  color: #a69a8f;
}

.login-card .login-button {
  display: flex;
  width: 100%;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  box-sizing: border-box;
  margin: 82rpx 0 0;
  padding: 0;
  border-radius: 999rpx;
  color: #ffffff;
  background: #965027;
  box-shadow: 0 14rpx 34rpx rgba(150, 80, 39, 0.26);
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 1;
}

.login-card .phone-login-button {
  margin-top: 38rpx;
}

.login-button::after {
  border: 0;
}

.login-button[disabled] {
  opacity: 0.68;
}

.login-button-hover {
  opacity: 0.86;
}

.wechat-icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.terms-row {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 14rpx;
  margin-top: 58rpx;
  min-height: 42rpx;
}

.terms-checkbox {
  display: flex;
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
  border: 2rpx solid rgba(122, 114, 107, 0.58);
  border-radius: 50%;
  background: #ffffff;
  box-sizing: border-box;
}

.terms-checkbox-checked {
  border-color: #965027;
  background: #965027;
}

.terms-check {
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
}

.terms-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-wrap: wrap;
  align-items: center;
  color: #88817a;
  font-size: 22rpx;
  line-height: 1.5;
}

.terms-link {
  color: #965027;
}

.login-mode-link {
  display: block;
  margin: 26rpx auto 0;
  padding: 10rpx 18rpx;
  color: #8b7565;
  font-size: 23rpx;
  text-align: center;
  line-height: 1.4;
}

.scenery {
  position: relative;
  flex: 1;
  width: calc(100% + 96rpx);
  min-height: 160rpx;
  margin: auto 0 0 -48rpx;
  overflow: hidden;
}

.river-wave {
  position: absolute;
  left: -5%;
  width: 110%;
  height: 54rpx;
}

.river-wave-back {
  bottom: 42rpx;
  border-radius: 54% 46% 0 0 / 72% 70% 0 0;
  background: rgba(139, 77, 37, 0.06);
  transform: rotate(-1deg);
}

.river-wave-front {
  bottom: 10rpx;
  border-radius: 48% 52% 0 0 / 68% 75% 0 0;
  background: rgba(139, 77, 37, 0.09);
  transform: rotate(1deg);
}

.footer-boat {
  position: absolute;
  bottom: 50rpx;
  left: 50%;
  width: 54rpx;
  height: 26rpx;
  transform: translateX(-50%);
  opacity: 0.45;
}

.boat-sail {
  position: absolute;
  bottom: 10rpx;
  left: 21rpx;
  width: 0;
  height: 0;
  border-right: 8rpx solid transparent;
  border-bottom: 14rpx solid #8b4d25;
  border-left: 8rpx solid transparent;
}

.boat-hull {
  position: absolute;
  bottom: 5rpx;
  left: 4rpx;
  width: 46rpx;
  height: 8rpx;
  border-radius: 0 0 50% 50%;
  background: #8b4d25;
}
