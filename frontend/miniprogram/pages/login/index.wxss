.page-shell {
  position: relative;
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  align-items: stretch;
  padding: 0 48rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: #fbf5ef;
}

.hero-scene {
  position: relative;
  flex-shrink: 0;
  width: calc(100% + 96rpx);
  height: 500rpx;
  margin-left: -48rpx;
  overflow: hidden;
}

.hero-background,
.hero-wash {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.hero-background { object-fit: cover; object-position: center center; }
.hero-wash { background: linear-gradient(180deg, rgba(251, 245, 239, .14) 0%, rgba(251, 245, 239, .08) 52%, rgba(251, 245, 239, .78) 88%, #fbf5ef 100%); }

.brand-block {
  position: absolute;
  z-index: 1;
  top: 72rpx;
  left: 0;
  display: flex;
  width: 100%;
  flex-direction: column;
  align-items: center;
}

.brand-heading { display: flex; align-items: center; justify-content: center; gap: 13rpx; }
.brand-title { color: #512a18; font-family: serif; font-size: 62rpx; font-weight: 600; letter-spacing: 8rpx; text-shadow: 0 2rpx 16rpx rgba(255, 252, 249, .72); }
.brand-seal { display: flex; width: 42rpx; height: 58rpx; flex-direction: column; align-items: center; justify-content: center; border-radius: 5rpx; color: #fffaf5; background: #b83b2a; font-family: serif; font-size: 21rpx; font-weight: 600; line-height: 1.15; }
.brand-subtitle { display: flex; align-items: center; gap: 14rpx; margin-top: 18rpx; color: #8b4d25; font-size: 23rpx; font-weight: 500; letter-spacing: 3rpx; }
.subtitle-rule { width: 34rpx; height: 1rpx; background: rgba(139, 77, 37, .48); }

.login-card {
  z-index: 1;
  width: 100%;
  margin-top: 22rpx;
  padding: 40rpx 34rpx 34rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(148, 111, 76, .18);
  border-radius: 30rpx;
  background: rgba(255, 252, 249, .97);
  box-shadow: 0 18rpx 54rpx rgba(70, 43, 24, .1);
}

.card-title { display: block; color: #292522; font-family: serif; font-size: 36rpx; font-weight: 600; text-align: center; }
.phone-field { display: flex; align-items: center; height: 96rpx; margin-top: 42rpx; padding: 0 28rpx; border: 1rpx solid #e7ddd1; border-radius: 24rpx; background: #faf7f2; }
.phone-icon { position: relative; width: 20rpx; height: 33rpx; flex-shrink: 0; border: 2rpx solid #897e74; border-radius: 5rpx; box-sizing: border-box; }
.phone-icon-dot { position: absolute; bottom: 3rpx; left: 50%; width: 3rpx; height: 3rpx; transform: translateX(-50%); border-radius: 50%; background: #897e74; }
.phone-input { flex: 1; height: 100%; padding-left: 22rpx; color: #292522; font-size: 29rpx; }
.placeholder { color: #b5aaa0; }
.error-message { display: block; margin-top: 14rpx; color: #bd493b; font-size: 22rpx; }
.login-button { display: block; width: 100%; height: 92rpx; margin: 32rpx 0 0; padding: 0; border-radius: 22rpx; color: #fffaf5; background: #98501f; box-shadow: 0 12rpx 26rpx rgba(152, 80, 31, .2); font-size: 29rpx; font-weight: 600; letter-spacing: 3rpx; line-height: 92rpx; }
.login-button::after { border: 0; }
.login-button[disabled] { opacity: .68; }
.terms-row { display: flex; align-items: center; justify-content: center; gap: 12rpx; margin-top: 26rpx; min-height: 40rpx; }
.terms-checkbox { display: flex; width: 28rpx; height: 28rpx; flex-shrink: 0; align-items: center; justify-content: center; border: 2rpx solid #a79d93; border-radius: 50%; background: #fffdfa; box-sizing: border-box; }
.terms-checkbox-checked { border-color: #98501f; background: #98501f; }
.terms-check { color: #fffaf5; font-size: 19rpx; font-weight: 600; line-height: 1; }
.terms-copy { display: flex; align-items: center; color: #86796d; font-size: 21rpx; line-height: 1.5; }
.terms-link { color: #98501f; }
.scenery { position: relative; flex: 1; width: calc(100% + 96rpx); min-height: 180rpx; margin: auto 0 0 -48rpx; overflow: hidden; }
.river-wave { position: absolute; left: -5%; width: 110%; height: 54rpx; }
.river-wave-back { bottom: 42rpx; border-radius: 54% 46% 0 0 / 72% 70% 0 0; background: rgba(231, 220, 208, .72); transform: rotate(-1deg); }
.river-wave-front { bottom: 10rpx; border-radius: 48% 52% 0 0 / 68% 75% 0 0; background: rgba(218, 202, 187, .58); transform: rotate(1deg); }
.footer-boat { position: absolute; bottom: 50rpx; left: 50%; width: 54rpx; height: 26rpx; transform: translateX(-50%); opacity: .58; }
.boat-sail { position: absolute; bottom: 10rpx; left: 21rpx; width: 0; height: 0; border-right: 8rpx solid transparent; border-bottom: 14rpx solid #b79e87; border-left: 8rpx solid transparent; }
.boat-hull { position: absolute; bottom: 5rpx; left: 4rpx; width: 46rpx; height: 8rpx; border-radius: 0 0 50% 50%; background: #b79e87; }
