.order-page{min-height:100vh;box-sizing:border-box;padding:36rpx 32rpx 80rpx;background:#fbf5ef;color:#292522}.order-heading{margin-bottom:28rpx;font-size:34rpx;font-weight:700;color:#512a18}.order-state{padding:80rpx 0;text-align:center;color:#7a726b;font-size:26rpx}.retry{margin-top:24rpx;background:#fffcf9;color:#98501f;font-size:24rpx}.order-card{margin-bottom:24rpx;padding:28rpx;border-radius:24rpx;background:#fffcf9;box-shadow:0 8rpx 32rpx rgba(81,42,24,.06)}.order-top{display:flex;justify-content:space-between;gap:16rpx;color:#7a726b;font-size:22rpx}.order-status{flex:none;color:#98501f}.order-name{margin-top:28rpx;font-size:30rpx;font-weight:600}.order-express{margin-top:16rpx;color:#7a726b;font-size:24rpx}.order-total{margin-top:24rpx;text-align:right;font-size:24rpx}.order-total text{color:#d74332;font-size:30rpx;font-weight:600}
.refund-button{width:180rpx;margin:20rpx 0 0 auto;padding:0;border:1rpx solid #98501f;border-radius:32rpx;background:#fffcf9;color:#98501f;font-size:24rpx;line-height:60rpx}.refund-button::after{border:0}
