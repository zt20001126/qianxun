<view class="orders-page">
  <view class="orders-heading">
    <view class="heading-title">
      <view class="heading-mark"></view>
      <text class="heading-copy">商城订单（{{total}}）</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="orders-state">正在读取订单…</view>
  <view wx:elif="{{errorMessage}}" class="orders-state orders-error">
    <text>{{errorMessage}}</text>
    <button class="retry-button" bindtap="onRetry">重新加载</button>
  </view>
  <view wx:elif="{{orders.length === 0}}" class="orders-empty">
    <image class="empty-icon" src="/assets/my-mall-orders.svg" mode="aspectFit" />
    <text class="empty-title">暂无商城订单</text>
    <text class="empty-hint">购买芊浔好物后的订单将显示在这里</text>
  </view>
  <view wx:else class="orders-list">
    <view wx:for="{{orders}}" wx:key="id" class="order-card" data-order-id="{{item.id}}" bindtap="onOrderTap">
      <view class="order-card-top">
        <text class="order-number">订单号：{{item.order_no}}</text>
        <text class="order-status status-{{item.status}}">{{item.status_label}}</text>
      </view>

      <view class="order-card-body">
        <view class="product-cover">
          <image wx:if="{{item.product_image}}" src="{{item.product_image}}" mode="aspectFill" />
          <image wx:else src="/assets/my-mall-orders.svg" mode="aspectFit" />
        </view>
        <view class="order-copy">
          <view class="order-title-row">
            <text class="order-product">{{item.product_name}}</text>
            <view class="order-title-side"><text class="product-quantity">×{{item.quantity}}</text><image class="chevron-icon" src="/assets/orders-chevron-right.svg" mode="aspectFit" /></view>
          </view>
          <view class="shipping-row">
            <text class="shipping-label">物流状态</text>
            <text class="shipping-value">{{item.shipping_label}}</text>
          </view>
          <view class="order-price-row">
            <text class="order-price-label">实付金额</text>
            <text class="order-price">¥{{item.paid_amount_display}}</text>
          </view>
        </view>
      </view>

    </view>
    <view wx:if="{{loadingMore}}" class="orders-loading-more">正在读取更多订单…</view>
  </view>
</view>
