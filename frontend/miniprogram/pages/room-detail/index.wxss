.detail-page { min-height: 100vh; padding-bottom: 44rpx; box-sizing: border-box; background: #fbf5ef; }
.detail-state { display: flex; min-height: 65vh; flex-direction: column; align-items: center; justify-content: center; gap: 18rpx; padding: 32rpx; color: #918276; font-size: 23rpx; text-align: center; }
.detail-error { color: #a94438; }
.room-gallery { width: 100%; height: 520rpx; background: #f2e6d9; }
.gallery-image { width: 100%; height: 100%; }
.gallery-empty { display: grid; place-items: center; color: #aa947d; font-family: serif; font-size: 25rpx; letter-spacing: 4rpx; background: linear-gradient(135deg, #f7eadc, #eee1d4); }
.detail-card { position: relative; margin: -22rpx 24rpx 0; padding: 31rpx 25rpx 26rpx; border: 1rpx solid #eee3d8; border-radius: 18rpx; background: #fffcf9; box-shadow: 0 12rpx 36rpx rgba(78, 54, 34, .065); }
.detail-title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; }
.detail-title-row > view:first-child { display: flex; flex-direction: column; min-width: 0; }
.detail-room-number { color: #a18e7c; font-size: 19rpx; letter-spacing: 1rpx; }
.detail-room-name { margin-top: 10rpx; color: #512a18; font-family: serif; font-size: 36rpx; font-weight: 600; line-height: 1.35; }
.detail-price { display: flex; align-items: baseline; margin-top: 19rpx; color: #d74332; white-space: nowrap; }
.detail-price text:first-child { font-family: Georgia, serif; font-size: 34rpx; font-weight: 600; }
.detail-price text:last-child { margin-left: 4rpx; color: #9d8e80; font-size: 17rpx; }
.room-quick-facts { display: flex; flex-wrap: wrap; gap: 14rpx 35rpx; margin-top: 26rpx; padding: 20rpx 0; border-top: 1rpx solid #f0e8df; border-bottom: 1rpx solid #f0e8df; }
.room-quick-facts view { display: flex; flex-direction: column; gap: 7rpx; }
.fact-label { color: #a29589; font-size: 17rpx; }
.fact-value { color: #5f5145; font-size: 21rpx; }
.detail-section { margin-top: 27rpx; }
.section-title { display: block; margin-bottom: 12rpx; color: #512a18; font-family: serif; font-size: 25rpx; font-weight: 600; }
.description-text { display: block; color: #75695e; font-size: 21rpx; line-height: 1.8; }
.facility-list { display: flex; flex-wrap: wrap; gap: 11rpx; }
.facility-tag { padding: 9rpx 15rpx; border-radius: 999rpx; color: #7a624d; background: #f7ede2; font-size: 18rpx; }
.detail-note { margin: 23rpx 34rpx 0; color: #a0968c; font-size: 18rpx; line-height: 1.6; text-align: center; }
.back-button { min-height: 76rpx; padding: 0 28rpx; border: 1rpx solid #d8c7b6; border-radius: 11rpx; color: #795b43; background: #fffdfa; font-size: 23rpx; line-height: 74rpx; }
.back-button::after { border: 0; }
.detail-back { display: block; width: calc(100% - 68rpx); margin: 22rpx auto 0; }
