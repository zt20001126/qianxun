.detail-page { min-height: 100vh; padding-bottom: 44rpx; box-sizing: border-box; background: #fbf5ef; }
.detail-state { display: flex; min-height: 65vh; flex-direction: column; align-items: center; justify-content: center; gap: 18rpx; padding: 32rpx; color: #918276; font-size: 23rpx; text-align: center; }
.detail-error { color: #a94438; }
.room-gallery { width: 100%; height: 520rpx; background: #f2e6d9; }
.gallery-image { width: 100%; height: 100%; }
.gallery-empty { display: grid; place-items: center; color: #aa947d; font-family: serif; font-size: 25rpx; letter-spacing: 4rpx; background: linear-gradient(135deg, #f7eadc, #eee1d4); }
.detail-card { position: relative; margin: -22rpx 24rpx 0; padding: 31rpx 25rpx 26rpx; border: 1rpx solid #eee3d8; border-radius: 18rpx; background: #fffcf9; box-shadow: 0 12rpx 36rpx rgba(78, 54, 34, .065); }
.detail-title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; }
.detail-title-row > view:first-child { display: flex; flex-direction: column; min-width: 0; }
.detail-room-number { color: #a18e7c; font-size: 19rpx; letter-spacing: 1rpx; }
.detail-room-name { margin-top: 10rpx; color: #512a18; font-family: serif; font-size: 36rpx; font-weight: 600; line-height: 1.35; }
.detail-price { display: flex; align-items: baseline; margin-top: 19rpx; color: #d74332; white-space: nowrap; }
.detail-price text:first-child { font-family: Georgia, serif; font-size: 34rpx; font-weight: 600; }
.detail-price text:last-child { margin-left: 4rpx; color: #9d8e80; font-size: 17rpx; }
.room-quick-facts { display: flex; flex-wrap: wrap; gap: 14rpx 35rpx; margin-top: 26rpx; padding: 20rpx 0; border-top: 1rpx solid #f0e8df; border-bottom: 1rpx solid #f0e8df; }
.room-quick-facts view { display: flex; flex-direction: column; gap: 7rpx; }
.fact-label { color: #a29589; font-size: 17rpx; }
.fact-value { color: #5f5145; font-size: 21rpx; }
.detail-section { margin-top: 27rpx; }
.section-title { display: block; margin-bottom: 12rpx; color: #512a18; font-family: serif; font-size: 25rpx; font-weight: 600; }
.description-text { display: block; color: #75695e; font-size: 21rpx; line-height: 1.8; }
.facility-list { display: flex; flex-wrap: wrap; gap: 11rpx; }
.facility-tag { padding: 9rpx 15rpx; border-radius: 999rpx; color: #7a624d; background: #f7ede2; font-size: 18rpx; }
.detail-note { margin: 23rpx 34rpx 0; color: #a0968c; font-size: 18rpx; line-height: 1.6; text-align: center; }
.availability-card { margin: 24rpx 24rpx 0; padding: 25rpx 21rpx 22rpx; border: 1rpx solid #eee3d8; border-radius: 17rpx; background: #fffcf9; box-shadow: 0 9rpx 26rpx rgba(78, 54, 34, .045); }
.availability-heading { display: flex; align-items: flex-start; justify-content: space-between; }
.availability-heading .section-title { display: block; margin-bottom: 8rpx; }
.availability-subtitle { color: #9a8d80; font-size: 18rpx; }
.calendar-month-row { display: flex; align-items: center; justify-content: space-between; margin-top: 17rpx; padding: 0 16rpx; }
.month-title { color: #512a18; font-family: serif; font-size: 23rpx; font-weight: 600; }
.month-step { display: grid; width: 56rpx; height: 54rpx; place-items: center; margin: 0; padding: 0; border: 1rpx solid #eadfd3; border-radius: 9rpx; color: #805538; background: #fffaf5; font-size: 38rpx; line-height: 1; }
.month-step::after { border: 0; }
.month-step[disabled] { opacity: .35; }
.calendar-legend { display: flex; justify-content: center; gap: 34rpx; margin: 14rpx 0 17rpx; color: #8d7e70; font-size: 17rpx; }
.calendar-legend text { display: flex; align-items: center; gap: 8rpx; }
.legend-dot { width: 14rpx; height: 14rpx; border-radius: 50%; }
.legend-dot.is-open { background: #b8895f; }
.legend-dot.is-closed { background: #d8d0c8; }
.calendar-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 5rpx 2rpx; }
.calendar-weekday { display: grid; height: 46rpx; place-items: center; color: #a49688; font-size: 17rpx; }
.calendar-day { display: grid; min-width: 0; height: 58rpx; place-items: center; margin: 0; padding: 0; border: 0; border-radius: 50%; color: #5d5045; background: transparent; font-size: 19rpx; line-height: 1; }
.calendar-day::after { border: 0; }
.calendar-day.is-unavailable { color: #b7ada3; background: #f3eee8; text-decoration: line-through; }
.calendar-day.is-disabled { opacity: .4; }
.calendar-day.is-empty { visibility: hidden; }
.calendar-day.is-in-range { border-radius: 8rpx; color: #79461f; background: #f7eadc; }
.calendar-day.is-selected { border-radius: 50%; color: #fffaf4; background: #98501f; font-weight: 600; opacity: 1; }
.calendar-message { padding: 38rpx 0; color: #958679; font-size: 19rpx; text-align: center; }
.calendar-message-error { color: #a94438; }
.stay-summary { display: grid; grid-template-columns: 1fr 1fr; gap: 10rpx; margin-top: 18rpx; }
.stay-summary view { display: flex; min-height: 65rpx; align-items: center; justify-content: space-between; padding: 0 13rpx; border: 1rpx solid #eee4d9; border-radius: 8rpx; background: #fffaf5; }
.stay-summary text:first-child { color: #a18d79; font-size: 16rpx; }
.stay-summary text:last-child { color: #5b4838; font-size: 18rpx; }
.availability-result { margin-top: 14rpx; padding: 14rpx; border-radius: 8rpx; color: #7b6652; background: #f7f1e9; font-size: 19rpx; line-height: 1.5; text-align: center; }
.availability-result.result-available { color: #537250; background: #eff5ec; }
.availability-result.result-unavailable { color: #a14439; background: #fbefeb; }
.search-stay-button { width: 100%; height: 72rpx; margin-top: 13rpx; border: 0; border-radius: 9rpx; color: #fffaf4; background: #98501f; font-size: 21rpx; line-height: 72rpx; }
.search-stay-button::after { border: 0; }
.book-stay-button { width: 100%; height: 76rpx; margin-top: 13rpx; border: 0; border-radius: 9rpx; color: #fffaf4; background: #98501f; font-size: 22rpx; line-height: 76rpx; }
.book-stay-button::after { border: 0; }
.calendar-footnote { display: block; margin-top: 14rpx; color: #aa9b8e; font-size: 16rpx; line-height: 1.5; text-align: center; }
.back-button { min-height: 76rpx; padding: 0 28rpx; border: 1rpx solid #d8c7b6; border-radius: 11rpx; color: #795b43; background: #fffdfa; font-size: 23rpx; line-height: 74rpx; }
.back-button::after { border: 0; }
.detail-back { display: block; width: calc(100% - 68rpx); margin: 22rpx auto 0; }
