.detail-page { min-height: 100vh; padding-bottom: calc(204rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #faf7f2; }
.detail-state { display: flex; min-height: 65vh; flex-direction: column; align-items: center; justify-content: center; gap: 24rpx; padding: 40rpx; color: #7a726b; font-size: 24rpx; text-align: center; }
.detail-error { color: #b83b2a; }
.gallery-wrap { position: relative; width: 100%; height: 562.5rpx; overflow: hidden; background: #f3ede2; }
.room-gallery { width: 100%; height: 100%; }
.gallery-image { display: block; width: 100%; height: 100%; }
.gallery-gradient { position: absolute; top: 0; right: 0; bottom: 0; left: 0; pointer-events: none; background: linear-gradient(0deg, rgba(35, 31, 29, .3), transparent 40%); }
.gallery-control { position: absolute; top: 50%; z-index: 2; display: flex; width: 88rpx; min-width: 88rpx; max-width: 88rpx; height: 88rpx; align-items: center; justify-content: center; box-sizing: border-box; padding: 0; transform: translateY(-50%); border: 1rpx solid rgba(81, 42, 24, .16); border-radius: 50%; background: rgba(255, 252, 249, .9); box-shadow: 0 4rpx 16rpx rgba(35, 31, 29, .16); }
.back-button::after, .book-button::after { border: 0; }
.gallery-previous { left: 48rpx; }
.gallery-next { right: 48rpx; }
.gallery-count { position: absolute; right: 32rpx; bottom: 40rpx; padding: 8rpx 24rpx; border-radius: 999rpx; color: #fff; background: rgba(35, 31, 29, .6); font-size: 24rpx; font-weight: 500; letter-spacing: 1rpx; }
.gallery-empty { display: flex; width: 100%; height: 562.5rpx; align-items: center; justify-content: center; color: #8b4d25; font-family: "Songti SC", serif; font-size: 25rpx; letter-spacing: 5rpx; background: linear-gradient(135deg, #f7efe8, #f3ede2); }
.detail-card { position: relative; z-index: 2; margin-top: -32rpx; padding: 40rpx 40rpx 48rpx; border-top: 1rpx solid rgba(232, 224, 212, .6); border-radius: 48rpx 48rpx 0 0; background: #fff; box-shadow: 0 -8rpx 36rpx rgba(35, 31, 29, .05); }
.detail-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.room-title { flex: 1; color: #231f1d; font-family: "Songti SC", "Noto Serif SC", serif; font-size: 40rpx; font-weight: 700; }
.floor-label { padding: 7rpx 20rpx; border-radius: 999rpx; color: #8b4d25; background: #f7efe8; font-size: 20rpx; font-weight: 500; }
.room-facts { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 32rpx; padding: 24rpx 0; border-top: 1rpx solid rgba(232, 224, 212, .7); border-bottom: 1rpx solid rgba(232, 224, 212, .7); }
.room-fact { display: flex; min-width: 0; align-items: center; justify-content: center; gap: 12rpx; padding: 0 8rpx; color: #231f1d; font-size: 24rpx; text-align: center; }
.room-fact + .room-fact { border-left: 1rpx solid rgba(232, 224, 212, .7); }
.room-fact text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.detail-section { margin-top: 40rpx; }
.section-heading { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; color: #6f3b1a; font-family: "Songti SC", "Noto Serif SC", serif; font-size: 28rpx; font-weight: 700; }
.section-rail { width: 8rpx; height: 32rpx; border-radius: 6rpx; background: #8b4d25; }
.room-description { display: block; color: rgba(35, 31, 29, .85); font-size: 24rpx; line-height: 1.625; }
.facility-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
.facility-item { display: flex; flex-direction: column; align-items: center; gap: 12rpx; color: #231f1d; font-size: 22rpx; }
.facility-item + .facility-item { border-left: 1rpx solid rgba(232, 224, 212, .6); }
.selected-stay { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 40rpx; padding: 24rpx; border: 1rpx solid rgba(232, 224, 212, .8); border-radius: 32rpx; background: #faf7f2; font-size: 24rpx; }
.stay-hint { color: #7a726b; }
.stay-value { color: #231f1d; font-weight: 600; }
.change-dates { display: flex; flex: none; align-items: center; color: #8b4d25; font-weight: 600; }
.availability-state { margin-top: 18rpx; color: #7a726b; font-size: 20rpx; }
.availability-error { color: #b83b2a; }
.detail-footer { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; display: flex; height: calc(140rpx + env(safe-area-inset-bottom)); align-items: center; justify-content: space-between; padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-top: 1rpx solid #e8e0d4; background: rgba(255, 255, 255, .96); box-shadow: 0 -12rpx 40rpx rgba(35, 31, 29, .05); }
.footer-price { display: flex; align-items: baseline; }
.currency { color: #b83b2a; font-size: 24rpx; font-weight: 700; }
.price-number { color: #b83b2a; font-size: 48rpx; font-weight: 700; }
.per-night { margin-left: 8rpx; color: #7a726b; font-size: 24rpx; }
.book-button { height: 90rpx; margin: 0; padding: 0 72rpx; border-radius: 32rpx; color: #fff; background: #8b4d25; box-shadow: 0 12rpx 36rpx rgba(139, 77, 37, .22); font-size: 28rpx; line-height: 90rpx; }
.book-button::after { border: 0; }
.home-indicator { position: absolute; bottom: calc(8rpx + env(safe-area-inset-bottom)); left: 50%; width: 256rpx; height: 8rpx; transform: translateX(-50%); border-radius: 999rpx; background: rgba(35, 31, 29, .2); }
.back-button { min-height: 72rpx; padding: 0 34rpx; border: 1rpx solid #e8e0d4; border-radius: 999rpx; color: #8b4d25; background: #fff; font-size: 22rpx; }
