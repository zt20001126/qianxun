<view class="detail-page">
  <view wx:if="{{loading}}" class="detail-state">正在读取房间资料…</view>
  <view wx:elif="{{errorMessage}}" class="detail-state detail-error">
    <text>{{errorMessage}}</text>
    <button class="back-button" bindtap="onBackTap">返回客房列表</button>
  </view>
  <view wx:elif="{{room}}" class="detail-content">
    <view wx:if="{{room.images.length}}" class="gallery-wrap">
      <swiper class="room-gallery" circular current="{{imageIndex}}" duration="280" bindchange="onGalleryChange">
        <swiper-item wx:for="{{room.images}}" wx:key="*this">
          <image class="gallery-image" src="{{item}}" mode="aspectFill" />
        </swiper-item>
      </swiper>
      <view class="gallery-gradient"></view>
      <button class="gallery-control gallery-previous" data-delta="-1" bindtap="onGalleryStep"><qx-icon name="chevron-left" size="32" /></button>
      <button class="gallery-control gallery-next" data-delta="1" bindtap="onGalleryStep"><qx-icon name="chevron-right" size="32" /></button>
      <view class="gallery-count">{{imageIndex + 1}} / {{imageCount}}</view>
    </view>
    <view wx:else class="gallery-empty"><text>暂无客房图片</text></view>

    <view class="detail-card">
      <view class="detail-heading">
        <text class="room-title">{{room.name}}</text>
        <text class="floor-label">{{room.floor}}F</text>
      </view>

      <view class="room-facts">
        <view class="room-fact">
          <qx-icon name="user" size="28" />
          <text>可住{{room.capacity}}人</text>
        </view>
        <view class="room-fact">
          <qx-icon name="bed-double" size="28" />
          <text>{{room.bed_info || '床型详见房间配置'}}</text>
        </view>
        <view wx:if="{{room.area}}" class="room-fact">
          <qx-icon name="maximize-2" size="28" />
          <text>{{room.area}}㎡</text>
        </view>
        <view wx:else class="room-fact">
          <qx-icon name="maximize-2" size="28" />
          <text>面积详询</text>
        </view>
      </view>

      <view wx:if="{{room.description}}" class="detail-section">
        <view class="section-heading"><view class="section-rail"></view><text>房间介绍</text></view>
        <text class="room-description">{{room.description}}</text>
      </view>

      <view wx:if="{{room.facilities.length}}" class="detail-section facilities-section">
        <view class="section-heading"><view class="section-rail"></view><text>设施配置</text></view>
        <view class="facility-grid">
        <view wx:for="{{facilities}}" wx:key="label" class="facility-item">
            <qx-icon name="{{item.icon}}" size="40" />
            <text>{{item.label || item}}</text>
          </view>
        </view>
      </view>

      <view class="selected-stay" bindtap="onCalendarOpen">
        <view><text class="stay-hint">已选行程：</text><text class="stay-value">{{checkInLabel}} - {{checkOutLabel}}</text></view>
        <text class="change-dates">修改日期 <qx-icon name="chevron-right" size="24" /></text>
      </view>
      <view wx:if="{{checkingAvailability}}" class="availability-state">正在复核整段日期…</view>
      <view wx:elif="{{availabilityError}}" class="availability-state availability-error">{{availabilityError}}</view>
      <view wx:elif="{{availability && !availability.available}}" class="availability-state availability-error">所选日期区间暂不可订</view>
    </view>
  </view>

  <view wx:if="{{room && !loading && !errorMessage}}" class="detail-footer">
    <view class="footer-price"><text class="currency">¥</text><text class="price-number">{{priceLabel}}</text><text class="per-night">/晚</text></view>
    <button class="book-button" loading="{{bookingLoading}}" disabled="{{bookingLoading}}" bindtap="onBookTap">立即预订</button>
    <view class="home-indicator"></view>
  </view>

  <booking-calendar
    visible="{{calendarVisible}}"
    room-id="{{room.id}}"
    check-in="{{checkIn}}"
    check-out="{{checkOut}}"
    bind:close="onCalendarClose"
    bind:confirm="onCalendarConfirm" />
</view>
