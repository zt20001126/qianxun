:host {
  display: block;
}

.detail-image-list {
  width: 100%;
}

/* 未加载时保留可观测的占位高度，加载后由原图比例撑开。 */
.detail-image-slot.is-pending {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 500rpx;
  overflow: hidden;
  background: #faf7f2;
}

.detail-image {
  display: block;
  width: 100%;
}

.image-retry {
  margin: 0;
  padding: 0 24rpx;
  color: #8b4d25;
  background: transparent;
  font-size: 24rpx;
  line-height: 88rpx;
}

.image-retry::after {
  border: 0;
}
