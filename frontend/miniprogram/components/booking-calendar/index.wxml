<view wx:if="{{visible}}" class="calendar-mask" catchtouchmove="noop">
  <view class="calendar-sheet">
    <view class="calendar-header">
      <button class="calendar-close" bindtap="onCloseTap"><text class="calendar-close-glyph">×</text></button>
      <view class="calendar-heading">
        <text class="calendar-title">选择入住与退房日期</text>
      </view>
      <view class="nights-badge"><qx-icon name="moon" size="24" /><text wx:if="{{nights > 0}}">共 {{nights}} 晚</text><text wx:else>待选退房</text></view>
    </view>

    <view class="calendar-preview">
      <view><text>入住：</text><text class="preview-value">{{checkInPreview}}</text></view>
      <qx-icon name="arrow-right" size="28" />
      <view><text>退房：</text><text class="preview-value">{{checkOutPreview}}</text></view>
    </view>

    <view class="calendar-legend">
      <view class="legend-item"><view class="legend-box available"></view><text>可订</text></view>
      <view class="legend-item"><view class="legend-box unavailable"></view><text>已满</text></view>
      <view class="legend-item"><view class="legend-box selected"></view><text>已选区间</text></view>
    </view>

    <scroll-view class="calendar-months-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view wx:for="{{months}}" wx:key="key" class="calendar-month-card">
        <text class="month-title">{{item.title}}</text>
        <view class="calendar-grid">
          <text wx:for="{{weekdays}}" wx:for-item="weekday" wx:key="*this" class="calendar-weekday">{{weekday}}</text>
          <button
            wx:for="{{item.days}}"
            wx:for-item="day"
            wx:key="key"
            class="calendar-day {{day.empty ? 'is-empty' : ''}} {{day.unavailable ? 'is-unavailable' : ''}} {{day.disabled ? 'is-disabled' : ''}} {{day.selected ? 'is-selected' : ''}} {{day.inRange ? 'is-in-range' : ''}}"
            disabled="{{day.disabled || item.loading}}"
            data-date="{{day.date}}"
            data-month="{{item.month}}"
            bindtap="onDayTap">
            <text>{{day.label}}</text>
            <text wx:if="{{day.isCheckIn}}" class="day-caption">入住</text>
            <text wx:elif="{{day.isCheckOut}}" class="day-caption">退房</text>
            <text wx:elif="{{day.unavailable}}" class="day-caption day-full-caption">已满</text>
            <text wx:elif="{{day.priceLabel}}" class="day-caption day-price">{{day.priceLabel}}</text>
          </button>
        </view>
        <text wx:if="{{item.loading}}" class="month-state">正在读取房态…</text>
        <text wx:elif="{{item.error}}" class="month-state month-error">{{item.error}}</text>
      </view>
    </scroll-view>

    <view class="calendar-footer">
      <button class="calendar-confirm {{nights > 0 ? '' : 'is-disabled'}}" disabled="{{nights < 1}}" bindtap="onConfirmTap">
        <text wx:if="{{nights > 0}}">确认日期（共 {{nights}} 晚）</text>
        <text wx:else>请选择退房日期</text>
      </button>
    </view>
  </view>
</view>
